---
/** /students — pro-bono counselling, mentoring, live projects and how to reach him. */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import pages from '../data/pages.json';

const p = pages.students;
---

<Base title="Students" description={p.meta}>
  <main id="main">
    <PageHeader eyebrow={p.eyebrow} title={p.title} intro={p.intro} placeholder={p.placeholder} />

    <section class="page-section container-content" aria-label="How he helps students">
      <ol class="students-ways" role="list">
        {
          p.sections.map((s, i) => (
            <li class="students-way" data-reveal style={`--i:${i}`}>
              <span class="students-way__num" aria-hidden="true">({String(i + 1).padStart(2, '0')})</span>
              <h2 class="students-way__title">{s.title}</h2>
              <p class="students-way__text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="page-section container-content" aria-labelledby="courses-title">
      <h2 id="courses-title" class="page-section__title" data-reveal>{p.coursesTitle}</h2>
      <dl class="students-courses">
        {
          p.courses.map((c, i) => (
            <div data-reveal style={`--i:${i}`}>
              <dt>{c.where}</dt>
              <dd>{c.what}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="page-section container-content" aria-labelledby="reach-title">
      <div class="students-reach" data-reveal>
        <h2 id="reach-title" class="page-section__title">{p.reachTitle}</h2>
        <p class="mt-4 prose-measure">{p.reach}</p>
        <a href={p.ctaHref} class="btn btn-primary mt-8">
          {p.cta} <Icon name="arrow-right" size={18} class="btn-arrow" />
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  .students-ways {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 768px) {
    .students-ways {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  .students-way {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }
  .students-way__num {
    font-size: var(--text-small);
    color: var(--color-stone);
  }
  .students-way__title {
    margin-top: 0.5rem;
    font-size: var(--text-h3);
  }
  .students-way__text {
    margin-top: 0.75rem;
    color: var(--color-stone);
  }
  .students-courses {
    display: grid;
    gap: 1.5rem;
    margin: 2rem 0 0;
  }
  @media (min-width: 768px) {
    .students-courses {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  .students-courses dt {
    font-weight: 600;
  }
  .students-courses dd {
    margin: 0.4rem 0 0;
    color: var(--color-stone);
  }
  .students-reach {
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
  }
</style>
