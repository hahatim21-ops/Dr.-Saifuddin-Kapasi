---
// Home page — one scroll, twelve sections in the brief's order.
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Loader from '../components/Loader.astro';
import Manifesto from '../components/home/Manifesto.astro';
import Arc from '../components/home/Arc.astro';
import Numbers from '../components/home/Numbers.astro';
import Pillars from '../components/home/Pillars.astro';
import Books from '../components/home/Books.astro';
import Speaking from '../components/home/Speaking.astro';
import Gallery from '../components/home/Gallery.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Insights from '../components/home/Insights.astro';
import ContactSection from '../components/ContactSection.astro';
import { personSchema, websiteSchema } from '../lib/schema';

---

<Base navIntro jsonLd={[websiteSchema(), personSchema()]}>
  <Loader />
  <main id="main">
    <Hero />
    <Manifesto />
    <Arc />
    <Numbers />
    <Pillars />
    <Books />
    <Speaking />
    <Gallery />
    <Testimonials />
    <Insights />
    <ContactSection />
  </main>
</Base>
