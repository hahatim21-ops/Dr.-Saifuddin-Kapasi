---
// Home page — one scroll, twelve sections in the brief's order.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Arc from '../components/home/Arc.astro';
import Numbers from '../components/home/Numbers.astro';
import Pillars from '../components/home/Pillars.astro';
import Books from '../components/home/Books.astro';
import Frameworks from '../components/home/Frameworks.astro';
import Speaking from '../components/home/Speaking.astro';
import Gallery from '../components/home/Gallery.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Achievements from '../components/home/Achievements.astro';
import Insights from '../components/home/Insights.astro';
import ContactSection from '../components/ContactSection.astro';
import { heroPortrait } from '../lib/images';
import { personSchema, websiteSchema } from '../lib/schema';

// Preload the hero portrait (AVIF srcset) so it starts downloading with the HTML.
const heroPreload = await getImage({
  src: heroPortrait.src,
  widths: heroPortrait.widths,
  format: 'avif',
});
---

<Base navIntro jsonLd={[websiteSchema(), personSchema()]}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroPreload.srcSet.attribute}
    imagesizes={heroPortrait.sizes}
    fetchpriority="high"
  />
  <main id="main">
    <Hero />
    <Arc />
    <Numbers />
    <Pillars />
    <Books />
    <Frameworks />
    <Speaking />
    <Gallery />
    <Testimonials />
    <Achievements />
    <Insights />
    <ContactSection />
  </main>
</Base>
