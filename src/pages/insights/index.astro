---
/** /insights — every article, newest first, plus a note on the future newsletter. */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import InsightsList from '../../components/InsightsList.astro';
import pages from '../../data/pages.json';

const p = pages.insights;
const articles = (await getCollection('insights')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Insights" description={p.meta}>
  <main id="main">
    <PageHeader eyebrow={p.eyebrow} title={p.title} intro={p.intro} />
    <section class="page-section container-content" aria-label="All articles">
      <InsightsList articles={articles} headingLevel="h2" />
      <p class="ins-note" data-reveal>{p.newsletter}</p>
    </section>
  </main>
</Base>

<style>
  .ins-note {
    margin-top: 3rem;
    max-width: var(--container-prose);
    font-size: var(--text-small);
    color: var(--color-stone);
  }
</style>
