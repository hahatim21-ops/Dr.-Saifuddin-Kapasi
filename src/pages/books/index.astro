---
/**
 * /books — both books on one page (Motion v3: replaces /books/beyond-ideas and
 * /books/beyond-satisfaction, which now redirect to #<slug> here). An index of
 * the two covers with a one-line pitch each, then each book in full, then
 * bulk orders. The nav's "Books" link lands here instead of mid-home.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import BlurImage from '../../components/BlurImage.astro';
import BookDetail from '../../components/BookDetail.astro';
import Icon from '../../components/Icon.astro';
import pages from '../../data/pages.json';
import home from '../../data/home.json';
import { bookSchema } from '../../lib/schema';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const p = pages.books;
const pageUrl = new URL('/books/', Astro.site).href;
const jsonLd = await Promise.all(
  books.map(async (b) => {
    const coverUrl = b.data.cover
      ? new URL((await getImage({ src: b.data.cover, width: 640, format: 'jpg' })).src, Astro.site).href
      : undefined;
    return bookSchema(b, `${pageUrl}#${b.id}`, coverUrl);
  })
);
---

<Base title="Books" description={home.books.intro} jsonLd={jsonLd}>
  <main id="main">
    <PageHeader eyebrow={home.books.eyebrow} title={home.books.title} intro={home.books.intro} />

    <!-- Index: both covers, a one-line pitch each -->
    <nav class="container-content bk-index" aria-label="The books">
      {
        books.map((b) => (
          <a href={`#${b.id}`} class="bk-index__item" data-reveal>
            {b.data.cover && <BlurImage src={b.data.cover} alt="" sizes="7rem" widths={[160, 320]} class="bk-index__cover" />}
            <span class="bk-index__text">
              <span class="bk-index__title">
                {b.data.title} <em>{b.data.titleAccent}</em>
              </span>
              <span class="bk-index__pitch">{b.data.subtitle}</span>
            </span>
            <Icon name="arrow-right" size={22} class="bk-index__arrow" />
          </a>
        ))
      }
    </nav>

    {books.map((b, i) => <BookDetail book={b} first={i === 0} />)}

    <!-- Bulk orders -->
    <section id="bulk" class="page-section container-content" aria-labelledby="bulk-title">
      <div class="bk-bulk" data-reveal>
        <div>
          <h2 id="bulk-title" class="page-section__title" data-split="lines">{home.books.bulk}</h2>
          <p class="mt-3 text-stone prose-measure">{p.bulk}</p>
        </div>
        <a href={home.books.bulkHref} class="btn btn-primary" data-magnetic>
          {p.bulkCta} <Icon name="arrow-right" size={18} class="btn-arrow" />
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  .bk-index {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 768px) {
    .bk-index {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }
  .bk-index__item {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-tap) var(--ease);
  }
  .bk-index__item:hover {
    border-color: var(--color-green);
  }
  .bk-index__item :global(.bk-index__cover) {
    aspect-ratio: 2 / 3;
    border-radius: 2px;
  }
  .bk-index__text {
    display: grid;
    gap: 0.3rem;
  }
  .bk-index__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.75rem;
    line-height: 1.1;
  }
  .bk-index__title em {
    color: var(--color-green);
  }
  .bk-index__pitch {
    color: var(--color-stone);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bk-index__item :global(.bk-index__arrow) {
    color: var(--color-brass);
    transition: transform var(--dur-tap) var(--ease);
  }
  @media (hover: hover) {
    .bk-index__item:hover :global(.bk-index__arrow) {
      transform: translateY(3px);
    }
  }
  .bk-bulk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
  }
</style>
