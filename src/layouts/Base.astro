---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// Preload the heading font (the hero/LCP text is set in it).
import cormorant600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import site from '../data/site.json';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PhoneDock from '../components/PhoneDock.astro';
import PrismTraveller from '../components/PrismTraveller.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative Open Graph image. */
  ogImage?: string;
  noindex?: boolean;
  /** Home page: nav fades in at 1000ms with the hero sequence. */
  navIntro?: boolean;
  /** Show the phone "Invite to speak" dock (off on /contact). */
  dock?: boolean;
  /** Open Graph type: website (default), article, book or profile. */
  ogType?: 'website' | 'article' | 'book' | 'profile';
  /** Alt text for the Open Graph image. */
  ogImageAlt?: string;
  /** Structured data (schema.org JSON-LD) for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  ogImage = '/og.jpg',
  noindex = false,
  navIntro = false,
  dock = true,
  ogType = 'website',
  ogImageAlt = `${site.name} — ${site.tagline}`,
  jsonLd,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
const ogIsDefault = ogImage === '/og.jpg';
---

<!doctype html>
<html lang="en-IN" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F6F1E7" />
    <!-- Hide-before-reveal only applies when JS runs; set before first paint. -->
    <script is:inline>
      (function (d) {
        d.classList.add('js');
        // Motion v2: hide split/clip targets for the few frames before GSAP sets
        // their real start state. Never under reduced motion; 2.5s failsafe.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('motion-pending');
          setTimeout(function () { d.classList.remove('motion-pending'); }, 2500);
        }
      })(document.documentElement);
    </script>
    <style is:inline>html{background:#F6F1E7}</style>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={cormorant600} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta name="author" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    {ogIsDefault && <meta property="og:image:width" content="1200" />}
    {ogIsDefault && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <slot name="head" />
    <ClientRouter fallback="animate" />
    <noscript>
      <style>
        [data-reveal],[data-reveal-word],[data-reveal-words] .rw,[data-motion],[data-arc-fill],[data-draw-x],[data-draw-y]{opacity:1!important;transform:none!important;filter:none!important}
        [data-draw-path] path,path[data-draw-path]{stroke-dasharray:none!important;stroke-dashoffset:0!important}
      </style>
    </noscript>
  </head>
  <body>
    <Nav intro={navIntro} />
    <slot />
    <Footer />
    {dock && <PhoneDock />}

    <PrismTraveller />
    <!-- Page-transition curtain (persists across pages; see src/lib/transition.ts) -->
    <div class="curtain" data-curtain transition:persist="curtain" aria-hidden="true">
      <svg viewBox="0 0 1200 120" preserveAspectRatio="none" focusable="false">
        <path data-curtain-line d="M0 110 H760 C960 110 1060 92 1200 8"></path>
      </svg>
    </div>

    <script>

      import { onPageLoad } from '../lib/page';

      /* ---- Motion v2 engine (GSAP + ScrollTrigger + Lenis, scenes, cursor,
              prism, curtain), downloaded only after the first paint of the
              hero portrait (the LCP image) so it never competes with it.
              Component scripts register their scenes meanwhile (lib/scenes);
              until the engine runs, html.motion-pending keeps reveal targets
              hidden (2.5s failsafe). ---- */
      let engineRequested = false;
      const loadEngine = () => {
        if (engineRequested) return;
        engineRequested = true;
        import('../lib/engine');
      };
      (() => {
        const img = document.querySelector<HTMLImageElement>('[data-hero] img');
        if (!img) return loadEngine();
        // Two frames after the image has loaded, it has been painted.
        const afterPaint = () => requestAnimationFrame(() => requestAnimationFrame(loadEngine));
        if (img.complete) afterPaint();
        else {
          img.addEventListener('load', afterPaint, { once: true });
          img.addEventListener('error', loadEngine, { once: true });
        }
        setTimeout(loadEngine, 1200); // never wait longer (slow image, background tab)
      })();

      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- v1 reveals still used by sections not yet moved to GSAP:
              CSS-driven, IntersectionObserver adds .is-in once ---- */
      let io: IntersectionObserver | null = null;
      function setupReveals() {
        io?.disconnect();
        const targets = document.querySelectorAll<Element>(
          '[data-reveal]:not(.is-in), [data-reveal-words]:not(.is-in), [data-draw-x]:not(.is-in), [data-draw-y]:not(.is-in), [data-draw-path]:not(.is-in)'
        );
        if (reduced() || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-in'));
          return;
        }
        io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              // Shown once on screen — or once scrolled past (a fast flick or an
              // anchor jump can carry it above the viewport between callbacks).
              const passed = entry.boundingClientRect.bottom < 0;
              if (!entry.isIntersecting && !passed) continue;
              entry.target.classList.add('is-in');
              io?.unobserve(entry.target); // play once
            }
          },
          // The root reaches one screen above the viewport, so an element that
          // jumps from below to above between two frames still crosses it.
          { rootMargin: '100% 0px -8% 0px', threshold: 0.12 }
        );
        targets.forEach((el) => {
          // [data-reveal-now] plays on load (hero), on the next frame so the start state paints.
          if (el.hasAttribute('data-reveal-now')) {
            requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-in')));
          } else {
            io!.observe(el);
          }
        });
      }

      onPageLoad(() => setupReveals());

      // Safety net: an instant long jump (End key, anchor link) on a busy main
      // thread can skip an element's observer crossing. When scrolling stops,
      // anything already above the bottom of the screen is revealed.
      const sweepReveals = () => {
        const pending = document.querySelectorAll<Element>(
          '[data-reveal]:not(.is-in), [data-reveal-words]:not(.is-in), [data-draw-x]:not(.is-in), [data-draw-y]:not(.is-in), [data-draw-path]:not(.is-in)'
        );
        if (!pending.length) return;
        const vh = window.innerHeight;
        pending.forEach((el) => {
          if (el.hasAttribute('data-reveal-now')) return;
          if (el.getBoundingClientRect().top < vh) {
            el.classList.add('is-in');
            io?.unobserve(el);
          }
        });
      };
      window.addEventListener('scrollend', sweepReveals, { passive: true });
    </script>
  </body>
</html>
