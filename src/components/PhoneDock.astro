---
/**
 * Phone-only floating pill dock (<768px). Slides up once the hero ([data-hero])
 * has scrolled past — or after one screen on pages without a hero — and steps
 * aside when the contact section ([data-dock-stop]) or the footer comes into
 * view, so it never covers the form or the footer.
 * Hidden = translated down + transparent + inert (not focusable).
 */
import site from '../data/site.json';
import Icon from './Icon.astro';

const { contact } = site;
---

<div class="dock" data-dock inert>
  <a
    href={`https://wa.me/${contact.whatsapp}`}
    class="dock__icon"
    rel="noopener"
    target="_blank"
    aria-label="Message on WhatsApp"
  >
    <Icon name="whatsapp" size={22} />
  </a>
</div>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: max(1rem, calc(env(safe-area-inset-bottom) + 0.5rem));
    z-index: 40;
    width: max-content;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    /* No backdrop blur: a fixed bar re-blurs whatever scrolls under it every frame. */
    background: rgb(255 255 255 / 0.97);
    box-shadow: 0 10px 30px -12px rgb(13 12 17 / 0.28);
    opacity: 0;
    transform: translate3d(-50%, calc(100% + 1.5rem), 0);
    transition:
      opacity var(--dur-reveal) var(--ease),
      transform var(--dur-reveal) var(--ease);
  }
  .dock[data-visible] {
    opacity: 1;
    transform: translate3d(-50%, 0, 0);
  }
  @media (min-width: 768px) {
    .dock {
      display: none;
    }
  }
  .dock__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: var(--color-green);
    transition: background-color var(--dur-tap) var(--ease);
  }
  .dock__icon:active {
    background: var(--color-ivory-deep);
  }
  .dock__cta {
    border-radius: 999px;
    padding-inline: 1.35rem;
    white-space: nowrap;
  }
</style>

<script>
  import { onPageLoad } from '../lib/page';

  // Visibility is tracked with IntersectionObservers (no per-frame layout
  // reads): the dock shows on phones once the hero is passed, and steps aside
  // at the first "stop" region (the contact form) or the footer.
  const phone = window.matchMedia('(max-width: 767.98px)');
  let pastHero = false;
  let footerNear = false;
  let observers: IntersectionObserver[] = [];

  function apply() {
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    if (!dock) return;
    const show = phone.matches && pastHero && !footerNear;
    if (show !== dock.hasAttribute('data-visible')) {
      dock.toggleAttribute('data-visible', show);
      dock.inert = !show;
    }
  }

  // Pages without a hero: "past the top" means scrolled 90% of a screen.
  const onScroll = () => {
    const past = window.scrollY > window.innerHeight * 0.9;
    if (past !== pastHero) {
      pastHero = past;
      apply();
    }
  };

  function setup() {
    observers.forEach((o) => o.disconnect());
    observers = [];
    window.removeEventListener('scroll', onScroll);
    pastHero = footerNear = false;

    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (hero) {
      const io = new IntersectionObserver(
        ([e]) => {
          pastHero = !e.isIntersecting && e.boundingClientRect.top < 0;
          apply();
        },
        { rootMargin: '-64px 0px 0px 0px' }
      );
      io.observe(hero);
      observers.push(io);
    } else {
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }

    const stop = document.querySelector<HTMLElement>('[data-dock-stop]') ?? document.querySelector<HTMLElement>('[data-site-footer]');
    if (stop) {
      const io = new IntersectionObserver(
        ([e]) => {
          footerNear = e.isIntersecting || e.boundingClientRect.top < 0;
          apply();
        },
        { rootMargin: '0px 0px -24px 0px' }
      );
      io.observe(stop);
      observers.push(io);
    }
    apply();
  }

  phone.addEventListener('change', apply);
  onPageLoad(setup);
</script>
