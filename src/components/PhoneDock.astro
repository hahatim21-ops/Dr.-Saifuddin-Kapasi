---
/**
 * Phone-only floating pill dock (<768px). Slides up once the hero ([data-hero])
 * has scrolled past — or after one screen on pages without a hero — and steps
 * aside when the contact section ([data-dock-stop]) or the footer comes into
 * view, so it never covers the form or the footer.
 * Hidden = translated down + transparent + inert (not focusable).
 */
import site from '../data/site.json';
import Icon from './Icon.astro';

const { cta } = site.nav;
const { contact } = site;
---

<div class="dock" data-dock inert>
  <a
    href={`https://wa.me/${contact.whatsapp}`}
    class="dock__icon"
    rel="noopener"
    target="_blank"
    aria-label="Message on WhatsApp"
  >
    <Icon name="whatsapp" size={22} />
  </a>
  <a href={cta.href} class="btn btn-primary dock__cta">
    {cta.short} <Icon name="arrow-right" size={18} class="btn-arrow" />
  </a>
</div>

<style>
  .dock {
    position: fixed;
    left: 50%;
    bottom: max(1rem, calc(env(safe-area-inset-bottom) + 0.5rem));
    z-index: 40;
    width: max-content;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    background: rgb(246 241 231 / 0.93);
    -webkit-backdrop-filter: blur(12px) saturate(1.1);
    backdrop-filter: blur(12px) saturate(1.1);
    box-shadow: 0 10px 30px -12px rgb(28 31 30 / 0.28);
    opacity: 0;
    transform: translate3d(-50%, calc(100% + 1.5rem), 0);
    transition:
      opacity var(--dur-reveal) var(--ease),
      transform var(--dur-reveal) var(--ease);
  }
  .dock[data-visible] {
    opacity: 1;
    transform: translate3d(-50%, 0, 0);
  }
  @media (min-width: 768px) {
    .dock {
      display: none;
    }
  }
  .dock__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    color: var(--color-green);
    transition: background-color var(--dur-tap) var(--ease);
  }
  .dock__icon:active {
    background: var(--color-ivory-deep);
  }
  .dock__cta {
    border-radius: 999px;
    padding-inline: 1.35rem;
    white-space: nowrap;
  }
</style>

<script>
  const phone = window.matchMedia('(max-width: 767.98px)');
  let ticking = false;

  function update() {
    ticking = false;
    const dock = document.querySelector<HTMLElement>('[data-dock]');
    if (!dock) return;
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    // Step aside at the first "stop" region (the contact form) or the footer.
    const stop = document.querySelector<HTMLElement>('[data-dock-stop]') ?? document.querySelector<HTMLElement>('[data-site-footer]');
    const vh = window.innerHeight;

    const pastHero = hero ? hero.getBoundingClientRect().bottom < 64 : window.scrollY > vh * 0.9;
    const footerNear = stop ? stop.getBoundingClientRect().top < vh - 24 : false;
    const show = phone.matches && pastHero && !footerNear;

    if (show !== dock.hasAttribute('data-visible')) {
      dock.toggleAttribute('data-visible', show);
      dock.inert = !show;
    }
  }

  const schedule = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  phone.addEventListener('change', schedule);
  document.addEventListener('astro:page-load', update);
</script>
