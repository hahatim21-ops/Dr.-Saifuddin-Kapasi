---
/** Small line icons, 1.5px stroke, currentColor. Decorative unless `label` is given. */
interface Props {
  name: 'menu' | 'close' | 'plus' | 'arrow-right' | 'arrow-up' | 'mail' | 'phone' | 'whatsapp' | 'linkedin';
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  menu: 'M4 8h16M4 16h16',
  close: 'M6 6l12 12M18 6L6 18',
  plus: 'M12 5v14M5 12h14',
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  'arrow-up': 'M12 19V5M6 11l6-6 6 6',
  mail: 'M3.5 6.5h17v11h-17zM4 7l8 6 8-6',
  phone:
    'M6.6 3.5h2.6l1.3 4-1.9 1.3a11 11 0 0 0 6.6 6.6l1.3-1.9 4 1.3v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z',
  // Simplified chat-bubble mark for WhatsApp (line style, not the brand logo).
  whatsapp:
    'M12 3.5a8.5 8.5 0 0 0-7.4 12.7L3.5 20.5l4.4-1.1A8.5 8.5 0 1 0 12 3.5zM9.2 8.4c.3-.3.8-.3 1 .1l.7 1.4c.1.3 0 .6-.2.8l-.5.5a6 6 0 0 0 2.6 2.6l.5-.5c.2-.2.5-.3.8-.2l1.4.7c.4.2.4.7.1 1-.6.7-1.5 1-2.4.7a8 8 0 0 1-4.8-4.8c-.3-.9 0-1.8.8-2.3z',
  linkedin: 'M4 9.5h3.2V20H4zM5.6 4a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zM10 9.5h3v1.5c.5-.9 1.7-1.8 3.4-1.8 3.3 0 3.6 2.1 3.6 4.9V20h-3.2v-5.2c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V20H10z',
};
const filled = name === 'linkedin';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' }}
>
  <path d={paths[name]}></path>
</svg>
