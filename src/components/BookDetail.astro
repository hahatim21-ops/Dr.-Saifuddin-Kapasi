---
/**
 * One book in full, as a section of /books (Motion v3 folded the two
 * /books/[slug] pages into one page; the old URLs redirect to #<slug>):
 * cover, title, pitch, facts, buy links, synopsis, contents, praise and the
 * excerpt band. Headings start at h2 (the page's h1 is "Books").
 */
import { render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BookCover from './BookCover.astro';
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';
import pages from '../data/pages.json';
import home from '../data/home.json';

interface Props {
  book: CollectionEntry<'books'>;
  /** The first book's cover loads eagerly. */
  first?: boolean;
}
const { book, first = false } = Astro.props;
const d = book.data;
const p = pages.books;
const { Content } = await render(book);

const COVER_WIDTHS = [320, 480, 640, 800];
const cover = d.cover
  ? await (async () => {
      const [avif, webp, fallback] = await Promise.all([
        getImage({ src: d.cover!, widths: COVER_WIDTHS, format: 'avif' }),
        getImage({ src: d.cover!, widths: COVER_WIDTHS, format: 'webp' }),
        getImage({ src: d.cover!, width: 640, format: 'jpg' }),
      ]);
      return {
        avifSrcset: avif.srcSet.attribute,
        webpSrcset: webp.srcSet.attribute,
        fallbackSrc: fallback.src,
        width: d.cover!.width,
        height: d.cover!.height,
      };
    })()
  : null;

const isLive = (url: string) => url && url !== '#';
const live = d.buyLinks.filter((l) => isLive(l.url));
const pending = d.buyLinks.filter((l) => !isLive(l.url));
const fmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const id = book.id;
---

<article id={id} class="bk" aria-labelledby={`${id}-title`}>
  <!-- Book hero -->
  <div class="bk-hero container-content">
    <div class="bk-hero__cover">
      {cover && <BookCover {...cover} eager={first} alt={d.coverAlt} sizes="(min-width: 768px) 22rem, min(64vw, 17rem)" />}
    </div>
    <div class="bk-hero__text">
      {
        d.status === 'new-release' && (
          <p data-reveal="fade">
            <span class="pill">{home.books.newRelease}</span>
          </p>
        )
      }
      <h2 id={`${id}-title`} class="bk-hero__title" data-split="lines">
        {d.title} <span class="bk-hero__accent">{d.titleAccent}</span>
      </h2>
      <p class="bk-hero__subtitle" data-reveal>{d.subtitle}</p>
      <p class="bk-hero__pitch" data-reveal>{d.pitch}</p>
      <dl class="bk-hero__facts" data-reveal>
        {d.published && (
          <div>
            <dt>Published</dt>
            <dd>{fmt.format(d.published)}</dd>
          </div>
        )}
        {d.publisher && (
          <div>
            <dt>Publisher</dt>
            <dd>{d.publisher.startsWith('PLACEHOLDER') ? <span class="placeholder-tag">To confirm</span> : d.publisher}</dd>
          </div>
        )}
        {d.isbn && (
          <div>
            <dt>ISBN</dt>
            <dd>{d.isbn}</dd>
          </div>
        )}
      </dl>
      <div class="bk-hero__actions" data-reveal>
        {
          live.map((l) => (
            <a href={l.url} class="btn btn-primary" rel="noopener" target="_blank" data-magnetic>
              Buy on {l.label} <Icon name="arrow-right" size={18} class="btn-arrow" />
            </a>
          ))
        }
        <a href="#bulk" class="btn btn-secondary">{p.bulkCta}</a>
      </div>
      {
        pending.length > 0 && (
          <p class="mt-3" data-reveal="fade">
            <span class="placeholder-tag">{pending.map((l) => l.label).join(', ')} link to come</span>
          </p>
        )
      }
    </div>
  </div>

  <!-- Synopsis + contents, praise -->
  <div class="page-section container-content">
    <div class="bk-two">
      <div>
        <h3 class="bk-sub">{p.synopsis}</h3>
        {d.placeholder && <p class="mt-3"><span class="placeholder-tag">Placeholder synopsis</span></p>}
        <div class="prose-body mt-6" data-reveal><Content /></div>
      </div>
      <div>
        <h3 class="bk-sub">{p.contents}</h3>
        <p class="mt-6 text-stone" data-reveal>
          {p.contentsPlaceholder} <span class="placeholder-tag ml-1">Placeholder</span>
        </p>
        <p class="mt-8" data-reveal>
          <span class="placeholder-tag">{p.samplePlaceholder}</span>
        </p>
      </div>
    </div>

    {
      d.quote && (
        <div class="bk-quote" data-reveal>
          <h3 class="bk-sub">{p.praise}</h3>
          <figure>
            <blockquote>
              <p>{d.quote.text}</p>
            </blockquote>
            <figcaption>
              — {d.quote.author}
              {d.quote.role && <span>, {d.quote.role}</span>}
              {d.quote.placeholder && <span class="placeholder-tag ml-2">Placeholder</span>}
            </figcaption>
          </figure>
        </div>
      )
    }
  </div>

  <!-- Excerpt band -->
  {
    d.excerpt && (
      <div class="on-green bk-excerpt">
        <div class="container-content">
          <Eyebrow>{home.books.excerptEyebrow}</Eyebrow>
          <blockquote class="bk-excerpt__text" data-reveal>
            <p>{d.excerpt}</p>
          </blockquote>
          {d.placeholder && <span class="placeholder-tag">Placeholder excerpt</span>}
        </div>
      </div>
    )
  }
</article>

<style>
  .bk {
    /* (Anchor offset comes from html scroll-padding-top / Lenis.) The cover
       rises in rotated; never let a corner widen the page on phones. */
    overflow-x: clip;
  }
  .bk + .bk {
    border-top: 1px solid var(--color-hairline);
  }
  .bk-hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    padding-bottom: clamp(1rem, 2vw, 2rem);
  }
  .bk-hero__cover {
    width: min(64vw, 17rem);
    margin-inline: auto;
    padding-right: 10px;
  }
  @media (min-width: 768px) {
    .bk-hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
    .bk-hero__cover {
      width: min(100%, 22rem);
    }
  }
  .bk-hero__title {
    margin-top: 1rem;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
  }
  .bk-hero__accent {
    font-style: italic;
    color: var(--color-green);
  }
  .bk-hero__subtitle {
    margin-top: 0.75rem;
    color: var(--color-stone);
    max-width: 52ch;
  }
  .bk-hero__pitch {
    margin-top: 1.25rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    max-width: 52ch;
  }
  .bk-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 1.75rem 0 0;
  }
  .bk-hero__facts dt {
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-stone);
  }
  .bk-hero__facts dd {
    margin: 0.25rem 0 0;
  }
  .bk-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (max-width: 639.98px) {
    .bk-hero__actions > * {
      flex: 1 1 100%;
    }
  }

  .bk-two {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .bk-two {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 5rem;
    }
  }
  .bk-sub {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-h3);
    line-height: 1.15;
  }

  .bk-quote {
    margin-top: clamp(3rem, 5vw, 4.5rem);
    max-width: 48rem;
  }
  .bk-quote figure {
    margin: 1.25rem 0 0;
  }
  .bk-quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-style: italic;
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    line-height: 1.25;
  }
  .bk-quote figcaption {
    margin-top: 1rem;
    color: var(--color-stone);
  }

  .bk-excerpt {
    background: var(--color-green);
    color: var(--color-ivory);
    padding-block: clamp(4rem, 3rem + 5vw, 7rem);
  }
  .bk-excerpt__text {
    margin: 1.25rem 0 1.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    font-size: var(--text-h3);
    line-height: 1.3;
    max-width: 36ch;
  }
</style>
