---
/**
 * Home §8 — Speaking & training (the site's main goal). Motion v2: one list of
 * five large programme cards for every width.
 * - Desktop: the stage pins and vertical scroll moves the cards sideways, with
 *   a "01 / 05" counter and a brass progress bar. Cards tilt slightly in the
 *   scroll direction (skew ≤ 3°, from scroll velocity) and the track can be
 *   dragged. Cards stay keyboard-focusable: focusing one scrolls it into view.
 * - Phones/tablets (and JS off, reduced motion): a native scroll-snap swipe row
 *   (the page itself never scrolls sideways), plus the counter.
 * Then a "Past audiences" line and the invitation button.
 */
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import site from '../../data/site.json';
import { field } from '../../lib/placeholder';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';

const t = home.speaking;
const programmes = (await getCollection('programmes'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p, i) => ({
    id: p.id,
    num: String(i + 1).padStart(2, '0'),
    title: p.data.title,
    summary: p.data.summary,
    facts: [
      { label: t.labels.format, ...field(p.data.format) },
      { label: t.labels.duration, ...field(p.data.duration) },
      { label: t.labels.audience, ...field(p.data.audience) },
    ],
    href: `${t.enquireHref}&programme=${p.id}`,
  }));
const total = String(programmes.length).padStart(2, '0');
---

<section id="speaking" class="speaking" aria-labelledby="speaking-title">
  <div class="speaking__stage" data-prog-stage>
    <div class="container-content speaking__head">
      <SectionHeader eyebrow={t.eyebrow} id="speaking-title" title={t.title} intro={t.intro} />
    </div>

    <div class="prog-wrap" data-prog-wrap>
      <p class="prog-hint container-content">{t.swipeHint}</p>
      <ul class="prog-track" role="list" aria-label={t.eyebrow} tabindex="0" data-prog-track data-cursor="Drag">
        {
          programmes.map((p) => (
            <li class="prog-card" data-prog-card>
              <p class="prog-card__num" aria-hidden="true">
                {p.num}
              </p>
              <h3 class="prog-card__title">{p.title}</h3>
              <p class="prog-card__lede">{p.summary}</p>
              <dl class="prog-card__facts">
                {p.facts.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd>
                      {f.value}
                      {f.placeholder && <span class="placeholder-tag ml-1">To confirm</span>}
                    </dd>
                  </div>
                ))}
              </dl>
              <a href={p.href} class="prog-card__enquire link-grow-line">
                {t.enquire} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="container-content prog-meter" aria-hidden="true">
        <span class="prog-meter__count"><span data-prog-count>01</span> / {total}</span>
        <span class="prog-meter__bar"><span class="prog-meter__fill" data-prog-fill></span></span>
      </div>
    </div>
  </div>

  <div class="container-content">
    <div class="speaking__foot" data-reveal>
      <p class="speaking__past">
        <span class="speaking__past-label">{t.pastAudiencesLabel}:</span>
        {t.pastAudiences.map((a) => <span class="speaking__aud">{a}</span>)}
      </p>
      <div class="speaking__actions">
        <a href={site.nav.cta.href} class="btn btn-primary" data-magnetic>
          {t.cta} <Icon name="arrow-right" size={18} class="btn-arrow" />
        </a>
        <a href={t.allHref} class="btn btn-secondary">{t.allLink}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .speaking {
    padding-block: var(--section-space);
  }
  .speaking__stage {
    background: var(--color-ivory);
  }

  /* ---------- Track (native swipe row; pinned + translated on desktop) ---------- */
  .prog-wrap {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .prog-hint {
    font-size: var(--text-small);
    color: var(--color-stone);
  }
  @media (min-width: 1024px) {
    .prog-hint {
      display: none;
    }
  }
  .prog-track {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    margin: 1rem 0 0;
    padding: 0.25rem max(var(--gutter), calc((100vw - var(--container-content)) / 2)) 1rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container-content)) / 2));
    scrollbar-width: thin;
    scrollbar-color: var(--color-hairline) transparent;
  }
  .prog-track:focus-visible {
    outline-offset: -2px;
  }
  /* Desktop, pinned: the page scroll drives the track, so it never scrolls itself. */
  .prog-wrap.is-pinned {
    overflow: clip;
  }
  .prog-wrap.is-pinned .prog-track {
    overflow: visible;
    scroll-snap-type: none;
    width: max-content;
    cursor: grab;
    user-select: none;
  }
  .prog-wrap.is-pinned .prog-track.is-dragging {
    cursor: grabbing;
  }

  .prog-card {
    flex: 0 0 min(84%, 22rem);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    background-color: var(--color-ivory);
    background-image: var(--grain);
    transform-origin: 50% 100%;
  }
  @media (min-width: 768px) {
    .prog-card {
      flex-basis: clamp(22rem, 44vw, 26rem);
      padding: 2rem;
    }
  }
  @media (min-width: 1024px) {
    .prog-card {
      flex-basis: clamp(24rem, 34vw, 32rem);
      padding: clamp(1.75rem, 2.2vw, 2.5rem);
    }
  }
  .prog-card__num {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.75rem, 1.8rem + 3vw, 4.5rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-brass);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .prog-card__title {
    font-size: 1.75rem; /* 28px — serif minimum */
    line-height: 1.12;
  }
  @media (min-width: 1024px) {
    .prog-card__title {
      font-size: var(--text-h3);
    }
  }
  .prog-card__lede {
    color: var(--color-stone);
  }
  .prog-card__facts {
    display: grid;
    gap: 0.9rem;
    margin: 0.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline);
  }
  @media (min-width: 1024px) {
    .prog-card__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.25rem;
    }
    .prog-card__facts > div:last-child {
      grid-column: 1 / -1;
    }
  }
  .prog-card__facts dt {
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-stone);
  }
  .prog-card__facts dd {
    margin: 0.35rem 0 0;
  }
  .prog-card__enquire {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-green);
    text-decoration: none;
  }

  /* ---------- Counter + progress bar ---------- */
  .prog-meter {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  .prog-meter__count {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-stone);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
  }
  .prog-meter__bar {
    position: relative;
    flex: 1;
    max-width: 20rem;
    height: 1px;
    background: var(--color-hairline);
  }
  .prog-meter__fill {
    position: absolute;
    inset: 0;
    background: var(--color-brass);
    transform: scaleX(0.2);
    transform-origin: left center;
  }

  /* ---------- Foot ---------- */
  .speaking__foot {
    display: grid;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 1024px) {
    .speaking__foot {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
  .speaking__past {
    max-width: 60rem;
    color: var(--color-stone);
  }
  .speaking__past-label {
    font-weight: 600;
    color: var(--color-ink);
    margin-right: 0.4rem;
  }
  .speaking__aud:not(:last-child)::after {
    content: '·';
    margin-inline: 0.5rem;
  }
  .speaking__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 639.98px) {
    .speaking__actions > * {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  import { gsap, registerScene, getLenis } from '../../lib/tools';
  import { GS } from '../../lib/motion';

  registerScene('speaking', ({ desktop }) => {
    const stage = document.querySelector<HTMLElement>('[data-prog-stage]');
    const wrap = document.querySelector<HTMLElement>('[data-prog-wrap]');
    const track = document.querySelector<HTMLElement>('[data-prog-track]');
    const countEl = document.querySelector<HTMLElement>('[data-prog-count]');
    const fill = document.querySelector<HTMLElement>('[data-prog-fill]');
    if (!stage || !wrap || !track || !countEl || !fill) return;
    const cards = [...track.querySelectorAll<HTMLElement>('[data-prog-card]')];
    const n = cards.length;
    const pad = (i: number) => String(i + 1).padStart(2, '0');
    const meter = (progress: number) => {
      countEl.textContent = pad(Math.min(n - 1, Math.round(progress * (n - 1))));
      fill.style.transform = `scaleX(${Math.max(0.2, progress)})`;
    };

    /* ---------- Phones / tablets / reduced motion: native swipe + counter ---------- */
    if (!desktop) {
      const onScroll = () => {
        const max = track.scrollWidth - track.clientWidth;
        meter(max > 0 ? track.scrollLeft / max : 0);
      };
      track.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      return () => track.removeEventListener('scroll', onScroll);
    }

    /* ---------- Desktop: pinned horizontal track ---------- */
    wrap.classList.add('is-pinned');
    const distance = () => Math.max(0, track.scrollWidth - wrap.clientWidth);
    const skewTo = gsap.quickTo(cards, 'skewX', { duration: 0.5, ease: 'power3' });
    const settle = gsap.delayedCall(0.14, () => skewTo(0)).pause();

    const tween = gsap.to(track, {
      x: () => -distance(),
      ease: 'none',
      scrollTrigger: {
        trigger: stage,
        start: () => (stage.offsetHeight > window.innerHeight ? 'bottom bottom' : 'center center'),
        end: () => '+=' + distance(),
        pin: true,
        scrub: GS.scrub,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          meter(self.progress);
          // Lean into the direction of travel, never more than 3°.
          skewTo(gsap.utils.clamp(-GS.skewMax, GS.skewMax, -self.getVelocity() / 450));
          settle.restart(true);
        },
      },
    });
    const st = tween.scrollTrigger!;
    const scrollToX = (x: number, immediate = false) => {
      const d = distance();
      const y = st.start + (d ? gsap.utils.clamp(0, d, x) / d : 0) * (st.end - st.start);
      const lenis = getLenis();
      if (lenis) lenis.scrollTo(y, { immediate });
      else window.scrollTo({ top: y, behavior: immediate ? 'auto' : 'smooth' });
    };

    // Keyboard: focusing a card (or its link) brings it into view.
    const onFocus = (e: FocusEvent) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('[data-prog-card]');
      if (!card) return;
      const r = card.getBoundingClientRect();
      const w = wrap.getBoundingClientRect();
      if (r.left >= w.left && r.right <= w.right) return;
      const current = -Number(gsap.getProperty(track, 'x'));
      scrollToX(current + r.left - w.left - parseFloat(getComputedStyle(track).paddingLeft), true);
    };

    // Drag: pulls the track (by moving the page scroll); a drag never clicks.
    let dragX: number | null = null;
    let startX = 0;
    let moved = false;
    const down = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragX = e.clientX;
      startX = -Number(gsap.getProperty(track, 'x'));
      moved = false;
    };
    const move = (e: PointerEvent) => {
      if (dragX === null) return;
      const dx = e.clientX - dragX;
      if (!moved && Math.abs(dx) > 6) {
        moved = true;
        track.classList.add('is-dragging');
      }
      if (moved) scrollToX(startX - dx * 1.4, true);
    };
    const up = () => {
      dragX = null;
      track.classList.remove('is-dragging');
    };
    const click = (e: MouseEvent) => {
      if (moved) {
        e.preventDefault();
        e.stopPropagation();
        moved = false;
      }
    };
    const noDrag = (e: Event) => e.preventDefault();
    track.addEventListener('focusin', onFocus);
    track.addEventListener('pointerdown', down);
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
    track.addEventListener('click', click, true);
    track.addEventListener('dragstart', noDrag);


    return () => {
      settle.kill();
      wrap.classList.remove('is-pinned');
      track.removeEventListener('focusin', onFocus);
      track.removeEventListener('pointerdown', down);
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      track.removeEventListener('click', click, true);
      track.removeEventListener('dragstart', noDrag);
      gsap.set(cards, { clearProps: 'transform' });
    };
  });
</script>
