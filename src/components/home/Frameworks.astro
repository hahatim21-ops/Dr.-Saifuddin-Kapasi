---
/**
 * Home §7 — Thinking tools (also the body of /frameworks, `standalone`).
 * Two frameworks, each an SVG diagram beside a numbered list of its stages.
 * Motion v2:
 * - Desktop: each framework pins in turn. Scrolling draws its diagram stage by
 *   stage (DrawSVG); the active stage lights up in the list and its one-line
 *   meaning swaps in beside it. Then the second framework does the same.
 * - Tablets (diagram visible, no pin): the diagram draws stage by stage once.
 * - Phones: the diagram is hidden; the list is a vertical stepper whose brass
 *   rail draws downward as each stage enters.
 * Every stage's words are always in the list, in reading order. JS off and
 * reduced motion show the finished diagram.
 */
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import FrameworkDiagram from '../FrameworkDiagram.astro';
import Prism from '../Prism.astro';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  /** /frameworks page: no section header or "explore" link (the page has its
   *  own h1), framework titles become h2, and "Where it's taught" is shown. */
  standalone?: boolean;
  taughtLabel?: string;
}
const { standalone = false, taughtLabel = "Where it's taught" } = Astro.props;
const TitleTag = standalone ? 'h2' : 'h3';

const frameworks = (await getCollection('frameworks')).sort((a, b) => a.data.order - b.data.order);
---

<section
  id="frameworks"
  class:list={['frameworks', { 'frameworks--page': standalone }]}
  {...standalone ? { 'aria-label': 'Frameworks' } : { 'aria-labelledby': 'frameworks-title' }}
>
  <div class="container-content">
    {
      !standalone && (
        <div class="frameworks__head">
          <SectionHeader eyebrow={home.frameworks.eyebrow} id="frameworks-title" title={home.frameworks.title} intro={home.frameworks.intro} />
          <div class="frameworks__prism" data-prism-static>
            <Prism />
          </div>
        </div>
      )
    }

    <div class="frameworks__list">
      {
        frameworks.map((fw, i) => (
          <article id={fw.id} class:list={['fw', { 'fw--flip': i % 2 === 1 }]} aria-labelledby={`fw-${fw.id}`} data-fw>
            <div class="fw__figure">
              <FrameworkDiagram shape={fw.data.shape} stages={fw.data.stages} center={fw.data.center} />
            </div>

            <div class="fw__text">
              <p class="fw__source" data-reveal="fade">
                {fw.data.source}
              </p>
              <TitleTag id={`fw-${fw.id}`} class="fw__title" {...(standalone ? { 'data-split': 'lines' } : { 'data-reveal': '' })}>
                {fw.data.title}
              </TitleTag>
              <p class="fw__summary" data-reveal style="--i:1">
                {fw.data.summary}
              </p>

              <div class="fw__steps">
              <ol class="fw__stages" role="list">
                {fw.data.stages.map((s, si) => (
                  <li class="fw-stage" data-stage={si} data-reveal style={`--i:${si + 2}`}>
                    <span class="fw-stage__num" aria-hidden="true">
                      {String(si + 1).padStart(2, '0')}
                    </span>
                    <span class="fw-stage__text">
                      <span class="fw-stage__name">{s.name}</span>
                      <span class="fw-stage__line">{s.line}</span>
                    </span>
                  </li>
                ))}
              </ol>
              </div>
              {standalone && fw.data.taught && (
                <p class="fw__taught" data-reveal>
                  <span class="fw__taught-label">{taughtLabel}:</span> {fw.data.taught}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {
      !standalone && (
        <p class="frameworks__more" data-reveal="fade">
          <a href={home.frameworks.linkHref} class="link-grow-line">
            {home.frameworks.link} <span aria-hidden="true">→</span>
          </a>
        </p>
      )
    }
  </div>
</section>

<style>
  .frameworks {
    padding-block: var(--section-space);
  }
  .frameworks--page {
    padding-top: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .frameworks--page .frameworks__list {
    margin-top: 0;
  }
  .fw__title {
    font-size: var(--text-h3);
  }
  .frameworks--page .fw__title {
    font-size: var(--text-h2);
  }
  .fw__taught {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
    max-width: 52ch;
    color: var(--color-stone);
  }
  .fw__taught-label {
    font-weight: 600;
    color: var(--color-ink);
  }
  .frameworks__head {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  .frameworks__prism {
    display: none;
  }
  @media (min-width: 768px) {
    .frameworks__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
    }
    .frameworks__prism {
      display: block;
    }
  }

  .frameworks__list {
    display: grid;
    gap: clamp(4rem, 3rem + 5vw, 7rem);
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* ---------- One framework ---------- */
  .fw {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .fw__figure {
    display: none; /* phones: the stepper says it all */
  }
  @media (min-width: 768px) {
    .fw {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
    .fw__figure {
      display: block;
      max-width: 30rem;
      width: 100%;
      justify-self: center;
    }
    .fw--flip .fw__figure {
      order: 2;
    }
  }

  .fw__source {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-stone);
  }
  .fw__title {
    margin-top: 0.5rem;
  }
  .fw__summary {
    margin-top: 1rem;
    max-width: 52ch;
    color: var(--color-stone);
  }

  /* ---------- Stage list / phone stepper ---------- */
  .fw__steps {
    position: relative;
    margin-top: 1.75rem;
  }
  .fw__stages {
    position: relative;
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Phone stepper: a brass segment from each step's circle down to the next
     one (never past the last), drawing downward as the step reveals. */
  .fw-stage:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(1.25rem - 0.5px);
    top: 2.5rem;
    bottom: -1.25rem;
    width: 1px;
    background: var(--color-brass);
  }
  :global(html.js) .fw-stage[data-reveal]:not(:last-child)::after {
    transform: scaleY(0);
    transform-origin: center top;
    transition: transform var(--dur-reveal) var(--ease);
    transition-delay: calc(var(--i, 0) * var(--stagger) + 250ms);
  }
  :global(html.js) .fw-stage[data-reveal].is-in:not(:last-child)::after {
    transform: scaleY(1);
  }
  @media (min-width: 768px) {
    .fw-stage:not(:last-child)::after {
      display: none; /* the diagram carries the connections */
    }
  }
  .fw-stage {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  .fw-stage__num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-brass);
    border-radius: 999px;
    background: var(--color-ivory);
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    transition:
      background-color var(--dur-tap) var(--ease),
      color var(--dur-tap) var(--ease),
      border-color var(--dur-tap) var(--ease);
  }
  .fw-stage__text {
    display: grid;
    gap: 0.15rem;
    padding-top: 0.35rem;
  }
  .fw-stage__name {
    font-weight: 600;
    font-size: 1.1875rem;
    transition: color var(--dur-tap) var(--ease);
  }
  .fw-stage__line {
    color: var(--color-stone);
  }

  /* Pointing at a stage highlights it and its node in the diagram. */
  @media (hover: hover) {
    .fw-stage:hover .fw-stage__num {
      background: var(--color-green);
      border-color: var(--color-green);
      color: var(--color-ivory);
    }
    .fw-stage:hover .fw-stage__name {
      color: var(--color-green);
    }
    .fw:has(.fw-stage[data-stage='0']:hover) :global(.fw-node-0 .fw-node__dot),
    .fw:has(.fw-stage[data-stage='1']:hover) :global(.fw-node-1 .fw-node__dot),
    .fw:has(.fw-stage[data-stage='2']:hover) :global(.fw-node-2 .fw-node__dot),
    .fw:has(.fw-stage[data-stage='3']:hover) :global(.fw-node-3 .fw-node__dot) {
      fill: var(--color-green);
      stroke: var(--color-green);
    }
    .fw:has(.fw-stage[data-stage='0']:hover) :global(.fw-node-0 .fw-node__num),
    .fw:has(.fw-stage[data-stage='1']:hover) :global(.fw-node-1 .fw-node__num),
    .fw:has(.fw-stage[data-stage='2']:hover) :global(.fw-node-2 .fw-node__num),
    .fw:has(.fw-stage[data-stage='3']:hover) :global(.fw-node-3 .fw-node__num) {
      fill: var(--color-ivory);
    }
  }

  /* Desktop pinned stepping (class set by the scene): the lit stage is full
     strength, the others recede; only opacity and transform change. */
  .fw.is-stepping .fw-stage {
    opacity: 0.32;
    transition: opacity 0.35s var(--ease-ui);
  }
  .fw.is-stepping .fw-stage.is-done {
    opacity: 0.6;
  }
  .fw.is-stepping .fw-stage.is-lit {
    opacity: 1;
  }
  .fw.is-stepping .fw-stage__line {
    transform: translateX(-10px);
    opacity: 0;
    transition:
      opacity 0.35s var(--ease-ui),
      transform 0.5s var(--ease-ui);
  }
  .fw.is-stepping .fw-stage.is-lit .fw-stage__line,
  .fw.is-stepping .fw-stage.is-done .fw-stage__line {
    transform: none;
    opacity: 1;
  }
  .fw.is-stepping .fw-stage.is-lit .fw-stage__num {
    background: var(--color-green);
    border-color: var(--color-green);
    color: var(--color-ivory);
  }
  .fw.is-stepping :global(.fw-node.is-lit .fw-node__dot) {
    fill: var(--color-green);
    stroke: var(--color-green);
  }
  .fw.is-stepping :global(.fw-node.is-lit .fw-node__num) {
    fill: var(--color-ivory);
  }

  .frameworks__more {
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    font-weight: 600;
    color: var(--color-green);
  }
  .frameworks__more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
  }
</style>

<script>
  import { gsap, registerScene } from '../../lib/tools';

  registerScene('frameworks', ({ reduce, desktop }) => {
    if (reduce) return;
    const restores: Array<() => void> = [];
    document.querySelectorAll<HTMLElement>('[data-fw]').forEach((fw) => {
      const figure = fw.querySelector<HTMLElement>('.fw__figure');
      // Phones: the diagram is hidden; the CSS stepper handles the list.
      if (!figure || getComputedStyle(figure).display === 'none') return;
      const nodes = [...fw.querySelectorAll<SVGGElement>('[data-fw-node]')];
      const connectors = [...fw.querySelectorAll<SVGGElement>('[data-fw-connector]')];
      const center = fw.querySelector('[data-fw-center]');
      const stages = [...fw.querySelectorAll<HTMLElement>('.fw-stage')];
      const n = nodes.length;

      // Stage i: node i pops in, then the connector to the next stage draws.
      const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
      gsap.set(nodes, { autoAlpha: 0, scale: 0.6, transformOrigin: '50% 50%' });
      connectors.forEach((c) => gsap.set(c.querySelectorAll('path'), { drawSVG: '0%' }));
      if (center) gsap.set(center, { autoAlpha: 0 });
      nodes.forEach((node, i) => {
        tl.to(node, { autoAlpha: 1, scale: 1, duration: 0.5 }, i);
        const c = connectors[i];
        if (c) tl.to(c.querySelectorAll('path'), { drawSVG: '100%', duration: 0.5, ease: 'none', stagger: 0.4 }, i + 0.45);
      });
      if (center) tl.to(center, { autoAlpha: 1, duration: 0.5 }, n - 0.2);

      if (!desktop) {
        // Tablets: draw once as it enters, on a clock.
        tl.pause();
        gsap.timeline({ scrollTrigger: { trigger: figure, start: 'top 75%', once: true } }).add(
          tl.tweenFromTo(0, tl.duration(), { duration: tl.duration() * 0.55, ease: 'none' })
        );
        return;
      }

      // Desktop: pinned and scrubbed; the list lights the active stage.
      stages.forEach((s) => s.removeAttribute('data-reveal'));
      fw.classList.add('is-stepping');
      let lit = -1;
      const light = (i: number) => {
        if (i === lit) return;
        lit = i;
        stages.forEach((s, si) => {
          s.classList.toggle('is-lit', si === i);
          s.classList.toggle('is-done', si < i);
        });
        nodes.forEach((nd, ni) => nd.classList.toggle('is-lit', ni === i));
      };
      light(0);
      gsap.timeline({
        scrollTrigger: {
          trigger: fw,
          start: () => (fw.offsetHeight < window.innerHeight * 0.9 ? 'center center' : 'top 12%'),
          end: () => '+=' + window.innerHeight * 0.4 * n, // Motion v3: shorter (was 0.55 per stage)
          pin: true,
          anticipatePin: 1,
          scrub: 0.3,
          invalidateOnRefresh: true,
          onUpdate: (self) => light(Math.min(n - 1, Math.floor(self.progress * n * 0.999))),
        },
      }).add(tl.paused(false), 0);
      restores.push(() => {
        fw.classList.remove('is-stepping');
        stages.forEach((s) => {
          s.setAttribute('data-reveal', '');
          s.classList.remove('is-lit', 'is-done');
          s.classList.add('is-in');
        });
        nodes.forEach((nd) => nd.classList.remove('is-lit'));
      });
    });
    return () => restores.forEach((f) => f());
  });
</script>
