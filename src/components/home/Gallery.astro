---
/**
 * Home §9 — In the room. Real session photos with quiet captions
 * ("Kampala convocation / 2026"). Each photo sharpens from a blurred
 * placeholder as it loads (BlurImage, lazy below the fold).
 * Motion v3:
 * - A huge "In the room" word sits still behind the photos.
 * - Desktop: each large photo wipes up once (clip-path) out of a slight tilt
 *   and settles; its caption follows. No scrub, no column parallax.
 * - Phones: the swipe row; each photo fades up as it enters.
 * Layout: ≥768px a staggered two-column grid; phones one scroll-snap row (the
 * column wrappers switch to display: contents, `order` keeps the sequence).
 * JS off / reduced motion: the tidy grid, nothing hidden.
 * Motion v4 (Onda's "studio"), desktop: the photos are dealt onto the table.
 * Each one rises into a stack in the middle of the track (scale 0.66, tilted),
 * then deals out to its place as you scroll (scrubbed; Onda's ease-out). This
 * replaces v3's one-shot clip wipe. Phones keep the fade-ups.
 */
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import { field } from '../../lib/placeholder';
import BlurImage from '../BlurImage.astro';
import SectionHeader from '../SectionHeader.astro';

const photos = (await getCollection('gallery'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p, i) => {
    const alt = field(p.data.alt);
    return { ...p.data, index: i, altText: alt.placeholder ? `Placeholder photo: ${alt.value}` : alt.value };
  })
  .filter((p) => p.image);

const columns = [photos.filter((p) => p.index % 2 === 0), photos.filter((p) => p.index % 2 === 1)];
const SIZES = '(min-width: 1024px) 480px, (min-width: 768px) 46vw, 80vw';
---

<section id="gallery" class="gallery" aria-labelledby="gallery-title">
  <span class="gallery__word" aria-hidden="true" data-gallery-word>{home.gallery.eyebrow}</span>
  <div class="container-content gallery__head">
    <SectionHeader eyebrow={home.gallery.eyebrow} id="gallery-title" title={home.gallery.title} intro={home.gallery.intro} />
    <p class="gallery__hint">{home.gallery.swipeHint}</p>
  </div>

  <div class="gallery__wrap">
    <div class="gallery__track" role="list" aria-label={home.gallery.eyebrow} tabindex="0">
      {
        columns.map((col, ci) => (
          <div class:list={['gallery__col', { 'gallery__col--b': ci === 1 }]} data-gallery-col={ci}>
            {col.map((p) => (
              <figure
                class="photo"
                role="listitem"
                style={`order:${p.index};--i:${ci};--ratio:${p.image!.width} / ${p.image!.height}`}
                data-photo={p.index}
                data-cursor="View"
              >
                <BlurImage src={p.image!} alt={p.altText} sizes={SIZES} class="photo__img" />
                <figcaption class="photo__caption">
                  <span>{p.caption}</span>
                  <span class="photo__sep" aria-hidden="true">/</span>
                  <span>{p.year}</span>
                  {p.placeholder && <span class="placeholder-tag ml-2">Placeholder</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .gallery {
    position: relative;
    overflow: clip;
    padding-block: var(--section-space);
  }
  .gallery__head,
  .gallery__wrap {
    position: relative;
    z-index: 1;
  }
  /* Huge word behind the collage (decorative). */
  .gallery__word {
    position: absolute;
    top: clamp(14rem, 22vw, 24rem);
    inset-inline: 0;
    display: flex;
    justify-content: center; /* centres the overflowing word on both sides */
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(5rem, 17vw, 19rem);
    line-height: 0.85;
    white-space: nowrap;
    color: rgb(108 60 255 / 0.1);
    pointer-events: none;
    user-select: none;
  }
  .photo {
    transform-origin: 50% 60%;
  }
  .gallery__hint {
    margin-top: 1.5rem;
    font-size: var(--text-small);
    color: var(--color-stone);
  }

  /* ---------- Phones: swipe row ---------- */
  .gallery__track {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
    padding: 0.25rem var(--gutter) 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--color-hairline) transparent;
  }
  .gallery__track:focus-visible {
    outline-offset: -2px;
  }
  .gallery__col {
    display: contents;
  }
  .photo {
    flex: 0 0 64%;
    margin: 0;
    scroll-snap-align: start;
  }
  .photo :global(.photo__img) {
    border-radius: 8px;
    aspect-ratio: 4 / 5; /* one tidy crop for the swipe row */
  }
  .photo__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.4rem;
    margin-top: 0.75rem;
    font-size: var(--text-small);
    color: var(--color-stone);
  }
  .photo__caption span:first-child {
    color: var(--color-ink);
  }
  .photo__sep {
    color: var(--color-brass);
  }

  /* ---------- ≥768px: staggered two-column grid ---------- */
  @media (min-width: 768px) {
    .gallery__hint {
      display: none;
    }
    .gallery__wrap {
      width: 100%;
      max-width: calc(var(--container-content) + 2 * var(--gutter));
      margin-inline: auto;
      padding-inline: var(--gutter);
    }
    .gallery__track {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 46rem; /* design v5: smaller photos (was 62rem) */
      margin-inline: 0; /* shares the left edge with the section heading */
      gap: clamp(1.5rem, 3vw, 3rem);
      margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
    .gallery__col {
      display: flex;
      flex-direction: column;
      gap: clamp(2.5rem, 4vw, 4rem);
    }
    .gallery__col--b {
      margin-top: clamp(3rem, 6vw, 6rem);
    }
    .photo {
      flex: none;
    }
    /* Natural proportions on larger screens. */
    .photo :global(.photo__img) {
      aspect-ratio: var(--ratio);
    }
  }
</style>

<script>
  import { gsap, registerScene, revealTrigger, whenNear } from '../../lib/tools';
  import { GS } from '../../lib/motion';

  /** Document top of an element from layout offsets (transforms ignored). */
  const pageTop = (el: HTMLElement) => {
    let y = 0;
    for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) y += n.offsetTop;
    return y;
  };
  // Onda's tilts for the stack (degrees), by photo.
  const TILT = [-8, 6, -4, 9, -6, 7];

  registerScene('gallery', ({ reduce, desktop }) => {
    const track = document.querySelector<HTMLElement>('.gallery__track');
    if (!track || reduce) return;
    const photos = [...track.querySelectorAll<HTMLElement>('[data-photo]')];

    // Phones/tablets (Tier 2): each photo simply fades up as it enters.
    if (!desktop) {
      photos.forEach((ph) =>
        gsap.from(ph, { autoAlpha: 0, y: 12, duration: 0.5, ease: GS.ease.reveal, scrollTrigger: revealTrigger(ph) })
      );
      return;
    }

    // Desktop (Motion v4, Onda's "studio"): built when the gallery comes near.
    // The stack sits on the track's centre line, 58% down the screen. Each photo
    // is dealt from it while its top travels from 92% to 50% of the screen.
    const START = 0.92;
    const END = 0.5;
    const STACK_Y = 0.58;
    return whenNear(track, () => {
      photos.forEach((ph) => {
        const i = Number(ph.dataset.photo);
        // Offsets from the photo's own place to the stack, at the moment the deal
        // starts (layout offsets, so the photo's own transform never skews them;
        // the photo and the track share the same offsetParent, .gallery__wrap).
        const dx = () => track.offsetLeft + track.offsetWidth / 2 - (ph.offsetLeft + ph.offsetWidth / 2);
        // Never lifted above the top of the photo area, so the stack never
        // covers the section heading.
        const dy = () => Math.max(window.innerHeight * (STACK_Y - START) - ph.offsetHeight / 2, track.offsetTop - ph.offsetTop);
        gsap.fromTo(
          ph,
          { x: dx, y: dy, rotation: TILT[i % TILT.length], scale: 0.66 },
          {
            x: 0,
            y: 0,
            rotation: 0,
            scale: 1,
            ease: 'power3.out', // Onda: cubic-bezier(.333, 1, .667, 1)
            // Numeric positions from layout offsets: as its own trigger the photo
            // would be measured in its from-state (lifted to the stack).
            scrollTrigger: {
              start: () => pageTop(ph) - window.innerHeight * START,
              end: () => pageTop(ph) - window.innerHeight * END,
              scrub: GS.scrub,
              invalidateOnRefresh: true,
              // Its own layer only while it is being dealt (no re-raster per frame).
              onToggle: (self) => gsap.set(ph, { willChange: self.isActive ? 'transform' : 'auto' }),
            },
          }
        );
      });
    });
  });
</script>
