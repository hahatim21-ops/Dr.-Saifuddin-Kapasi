---
/**
 * Home §1 — Hero (Motion v2).
 * - The giant name is the h1; its letters rise out of masks (SplitText chars).
 * - The existing sentence continues under it as the lead ("…is an architect of
 *   enduring institutions."), "enduring" in green italic.
 * - Eyebrow rotates Educator · Author · Advisor · Speaker (2.5s, mask slide,
 *   pauses off-screen), twice through, then rests on "Educator" (WCAG 2.2.2:
 *   no motion longer than ~20s without a stop); screen readers get the list once.
 * - Portrait: clip-path wipe, then settles; warm duotone grade in CSS.
 * - Live "Mumbai · 21:27 IST" clock, a "Scroll" cue, and the credibility names
 *   as a slow marquee (stops on hover/focus; a plain list with JS off or
 *   reduced motion).
 * - Desktop: the hero pins and the next section ([data-sheet]) slides over it
 *   like a sheet of paper while the hero scales to 0.94 and dims. Phones: no
 *   pin; the sheet overlaps with a negative margin and a shadow.
 * Everything is visible in the HTML; GSAP sets start states at runtime only.
 * The intro waits for the loader (loader:done) when it is playing.
 */
import site from '../../data/site.json';
import { heroPortrait } from '../../lib/images';
import BlurImage from '../BlurImage.astro';
import Icon from '../Icon.astro';
import InflectionLine from '../InflectionLine.astro';

const leadParts = site.heroLead.split(/(\*[^*]+\*)/).filter(Boolean);
---

<section data-hero data-section="Introduction" class="hero" aria-labelledby="hero-title">
  <div class="hero__inner" data-hero-inner>
    <div class="hero__top container-content">
      <p class="hero__eyebrow" data-intro>
        <InflectionLine variant="glyph" />
        <span class="sr-only">{site.heroRolesSr}</span>
        <span class="hero__roles" aria-hidden="true" data-roles>
          {site.heroRoles.map((r, i) => <span class:list={['hero__role', { 'is-active': i === 0 }]}>{r}</span>)}
        </span>
      </p>
      <p class="hero__clock" data-intro>
        <span>{site.clockCity}</span>
        <span aria-hidden="true">·</span>
        <time data-clock data-zone={site.clockZone}>{site.clockAbbr}</time>
      </p>
    </div>

    <div class="hero__grid container-content">
      <h1 id="hero-title" class="hero__name" data-hero-name data-intro>{site.heroName}</h1>
      <!-- Travelling prism, first waypoint: small, beside the name, faint beam -->
      <span class="hero__stop" data-prism-stop="hero" data-prism-scale="0.42" data-prism-beam="0.22" data-prism-anchor="right" data-prism-dx="-40" aria-hidden="true"></span>

      <div class="hero__portrait">
        <!-- Never hidden before the engine runs: the portrait is the LCP image. -->
        <div class="hero__frame" data-hero-frame>
          <BlurImage
            src={heroPortrait.src}
            alt={heroPortrait.alt}
            sizes={heroPortrait.sizes}
            widths={heroPortrait.widths}
            position={heroPortrait.position}
            priority
            class="hero__img"
          />
          {heroPortrait.placeholder && <span class="placeholder-tag hero__ph">Placeholder portrait</span>}
        </div>
      </div>

      <div class="hero__text">
        <p class="hero__lead" data-hero-lead data-intro>
          {leadParts.map((part) => (part.startsWith('*') ? <em class="accent">{part.slice(1, -1)}</em> : part))}
        </p>

        <dl class="hero__status" data-intro data-hero-later>
          <div>
            <dt>Currently:</dt>
            <dd>{site.currently}</dd>
          </div>
          <div>
            <dt>Previously:</dt>
            <dd>{site.previously}</dd>
          </div>
        </dl>

        <div class="hero__line" data-hero-line>
          <InflectionLine variant="hero" draw={false} />
        </div>

        <div class="hero__actions" data-intro data-hero-later>
          <a href={site.nav.cta.href} class="btn btn-primary" data-magnetic>
            {site.nav.cta.label} <Icon name="arrow-right" size={18} class="btn-arrow" />
          </a>
          <a href="#books" class="btn btn-secondary">Explore the books</a>
        </div>
      </div>
    </div>

    <div class="hero__bottom" data-intro data-hero-later>
      <div class="hero__cred container-content">
        <p class="hero__cred-label">{site.credibilityLabel}</p>
        <div class="hero__marquee" data-marquee>
          <ul class="hero__track" role="list" data-marquee-track>
            {site.credibility.map((name) => <li>{name}</li>)}
          </ul>
        </div>
      </div>
      <a href="#arc" class="hero__cue" data-scroll-cue>
        <span>{site.scrollCue}</span>
        <span class="hero__cue-line" aria-hidden="true"><span data-cue-pulse></span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0; /* the sheet after it (DOM order) paints above */
    min-height: 100svh;
  }
  .hero__inner {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(4.75rem + env(safe-area-inset-top));
    transform-origin: 50% 30%;
  }
  @media (min-width: 1024px) {
    .hero__inner {
      padding-top: calc(6rem + env(safe-area-inset-top));
    }
  }

  /* ---------- Top row: rotating eyebrow + clock ---------- */
  .hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .hero__eyebrow,
  .hero__clock {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-stone);
    font-variant-numeric: tabular-nums;
  }
  .hero__roles {
    display: inline-grid;
    overflow: hidden;
    height: 1.3em;
    line-height: 1.3;
  }
  .hero__role {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .hero__role.is-active {
    opacity: 1;
  }

  /* ---------- Name + portrait + text ---------- */
  .hero__grid {
    position: relative;
    display: grid;
    gap: 1.5rem;
    margin-top: 1.25rem;
    flex: 1;
    align-content: center;
  }
  .hero__name {
    position: relative;
    z-index: 2;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(4rem, 1.4rem + 10.6vw, 12rem);
    line-height: 0.88;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .hero__portrait {
    order: -1; /* phones: portrait above the name */
  }
  .hero__stop {
    position: absolute;
    right: 0;
    top: 0;
    width: 1px;
    height: 1px;
  }
  .hero__frame {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    height: clamp(11rem, 30svh, 20rem);
  }
  .hero__frame :global(.hero__img) {
    height: 100%;
  }
  /* Warm duotone grade (CSS only): mono → warm, then a brass/green wash. */
  .hero__frame :global(.blur-img__img) {
    filter: grayscale(1) sepia(0.42) saturate(1.15) contrast(1.04) brightness(1.02);
  }
  .hero__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgb(212 180 131 / 0.35), rgb(31 61 51 / 0.38));
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .hero__ph {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    background: var(--color-ivory);
  }

  .hero__lead {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.3rem + 1.9vw, 3rem);
    line-height: 1.1;
    max-width: 22ch;
    text-wrap: balance;
  }
  .hero__status {
    margin-top: 1.25rem;
    max-width: 36rem;
    display: grid;
    gap: 0.3rem;
  }
  .hero__status dt {
    display: inline;
    font-weight: 600;
  }
  .hero__status dd {
    display: inline;
    margin: 0 0 0 0.3em;
    color: var(--color-stone);
  }
  .hero__line {
    margin-top: 1.25rem;
    max-width: 22rem;
  }
  .hero__actions {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  /* ---------- Bottom: credibility marquee + scroll cue ---------- */
  .hero__bottom {
    position: relative;
    margin-top: 2rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }
  .hero__cred {
    display: grid;
    gap: 0.35rem;
    padding-top: 1rem;
    font-size: var(--text-small);
    color: var(--color-stone);
  }
  .hero__cred-label {
    font-weight: 600;
    color: var(--color-ink);
  }
  .hero__marquee {
    overflow: hidden;
  }
  .hero__track {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero__track li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.75rem;
  }
  /* Runtime marquee (added by JS when motion is allowed). */
  .hero__marquee.is-marquee .hero__track {
    flex-wrap: nowrap;
    width: max-content;
  }
  .hero__marquee.is-marquee .hero__track li::after {
    content: '·';
    margin-inline: 0.75rem;
  }
  .hero__cue {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero__cue {
      position: absolute;
      right: max(var(--gutter), calc((100vw - 75rem) / 2));
      bottom: 1.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      min-height: 2.75rem;
      font-size: var(--text-eyebrow);
      font-weight: 600;
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--color-stone);
      text-decoration: none;
    }
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: var(--color-hairline);
    overflow: hidden;
  }
  .hero__cue-line span {
    position: absolute;
    inset: 0;
    background: var(--color-brass);
    transform-origin: top;
  }

  /* ---------- Tablet & desktop layout ---------- */
  @media (min-width: 768px) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto auto;
      column-gap: 1.5rem;
      row-gap: 0;
      align-items: end;
    }
    .hero__name {
      grid-column: 1 / -1;
      grid-row: 1;
      align-self: start;
    }
    .hero__portrait {
      order: 0;
      grid-column: 8 / 13;
      grid-row: 1 / 3;
      align-self: start;
      margin-top: clamp(3rem, 8vw, 9rem); /* the name overlaps the portrait's top */
    }
    .hero__frame {
      height: min(calc(100svh - 22rem), 34rem);
      min-height: 18rem;
    }
    .hero__text {
      grid-column: 1 / 8;
      grid-row: 2;
      padding-top: 1.75rem;
      padding-bottom: 0.5rem;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, SplitText, registerScene, afterCurtain } from '../../lib/tools';
  import { GS } from '../../lib/motion';

  /**
   * Live local clock: "21:27 IST", refreshed every 20s. Runs in every context,
   * but only while it is on screen and the tab is visible (Motion v3).
   */
  function startClock(el: HTMLElement) {
    const zone = el.dataset.zone || 'Asia/Kolkata';
    const abbr = el.textContent?.trim() || 'IST';
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: zone });
    const tick = () => {
      const now = new Date();
      el.textContent = `${fmt.format(now)} ${abbr}`;
      el.setAttribute('datetime', now.toISOString());
    };
    let id = 0;
    let onScreen = true;
    const sync = () => {
      const run = onScreen && document.visibilityState === 'visible';
      if (run && !id) {
        tick();
        id = window.setInterval(tick, 20000);
      } else if (!run && id) {
        window.clearInterval(id);
        id = 0;
      }
    };
    const io = new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      sync();
    });
    io.observe(el);
    document.addEventListener('visibilitychange', sync);
    sync();
    return () => {
      io.disconnect();
      document.removeEventListener('visibilitychange', sync);
      window.clearInterval(id);
      el.textContent = abbr;
    };
  }

  registerScene('hero', ({ reduce, desktop }) => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const cleanups: Array<() => void> = [];
    const clock = hero.querySelector<HTMLElement>('[data-clock]');
    if (clock) cleanups.push(startClock(clock));
    if (reduce) return () => cleanups.forEach((f) => f());

    const q = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s)!;
    const name = q('[data-hero-name]');
    const lead = q('[data-hero-lead]');
    const underLoader = !!document.documentElement.dataset.loaderState;
    const frame = q('[data-hero-frame]');
    const img = frame.querySelector('img');
    const linePath = q<SVGPathElement>('[data-hero-line] path');
    // DrawSVG measures real length; the static component's pathLength=1 would skew it.
    linePath.removeAttribute('pathLength');
    const later = hero.querySelectorAll('[data-hero-later]');
    const top = hero.querySelectorAll('.hero__top [data-intro]');
    const nav = document.querySelector('[data-intro-nav]');

    /* ---- Intro timeline (paused until the loader is done) ---- */
    const nameSplit = SplitText.create(name, { type: 'lines,words,chars', mask: 'lines', aria: 'auto' });
    const tl = gsap.timeline({
      paused: true,
      defaults: { ease: GS.ease.reveal },
      onComplete: () => {
        // Hand the text back to the browser so later resizes reflow naturally.
        nameSplit.revert();
      },
    });
    // Portrait: under the first-visit loader (which covers the page) it wipes
    // in; on every other visit it has already painted and simply stays put —
    // it is never hidden, so the LCP image is never delayed.
    if (underLoader)
      tl.fromTo(frame, { clipPath: 'inset(100% 0% 0% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.3, ease: GS.ease.strong }, 0.3).from(
        img,
        { scale: 1.15, duration: 1.7 },
        0.3
      );
    tl.from(nameSplit.chars, { yPercent: 110, duration: 1.1, stagger: GS.stagger.chars }, 0.1)
      .from(top, { autoAlpha: 0, y: 12, duration: GS.dur.body, stagger: { amount: 0.2 } }, 0.35)
      .from(lead, { autoAlpha: 0, y: 16, duration: GS.dur.body }, 0.45)
      .from(later, { autoAlpha: 0, y: 16, duration: GS.dur.body, stagger: { amount: 0.3 } }, 0.6)
      .fromTo(linePath, { drawSVG: '0%' }, { drawSVG: '100%', duration: 1.2, ease: 'power2.inOut' }, 0.8);
    if (nav) tl.from(nav, { autoAlpha: 0, y: -8, duration: 0.8 }, 1.0);

    // Never under the loader or the page-transition curtain (Motion v3).
    const play = () =>
      afterCurtain(() => {
        tl.play();
        ScrollTrigger.refresh();
      });
    if (document.documentElement.dataset.loaderState) {
      document.addEventListener('loader:done', play, { once: true });
      cleanups.push(() => document.removeEventListener('loader:done', play));
    } else play();

    /* ---- Rotating eyebrow: two cycles, then it rests on the first role (pauses off-screen) ---- */
    const roles = [...hero.querySelectorAll<HTMLElement>('.hero__role')];
    if (roles.length > 1) {
      let i = 0;
      gsap.set(roles, { opacity: 1, yPercent: (k: number) => (k === 0 ? 0 : 110) });
      const swap = () => {
        const cur = roles[i];
        i = (i + 1) % roles.length;
        const next = roles[i];
        gsap.to(cur, { yPercent: -110, duration: 0.7, ease: GS.ease.strong });
        gsap.fromTo(next, { yPercent: 110 }, { yPercent: 0, duration: 0.7, ease: GS.ease.strong });
      };
      const swaps = roles.length * 2; // ends back on roles[0]
      const loop = gsap.timeline({ repeat: swaps - 1, delay: 2.5 }).call(swap).to({}, { duration: 2.5 });
      ScrollTrigger.create({ trigger: hero, start: 'top bottom', end: 'bottom top', onToggle: (s) => (s.isActive ? loop.resume() : loop.pause()) });
    }

    /* ---- Credibility marquee (stops on hover / focus / off-screen) ---- */
    const marquee = hero.querySelector<HTMLElement>('[data-marquee]');
    const track = marquee?.querySelector<HTMLElement>('[data-marquee-track]');
    if (marquee && track) {
      const originals = [...track.children];
      // A second copy makes the loop seamless; it is hidden from screen readers.
      originals.forEach((li) => {
        const c = li.cloneNode(true) as HTMLElement;
        c.setAttribute('aria-hidden', 'true');
        c.dataset.clone = '';
        track.append(c);
      });
      marquee.classList.add('is-marquee');
      const run = gsap.to(track, { xPercent: -50, duration: 38, ease: 'none', repeat: -1 });
      const pause = () => run.pause();
      const resume = () => run.resume();
      marquee.addEventListener('pointerenter', pause);
      marquee.addEventListener('pointerleave', resume);
      hero.addEventListener('focusin', pause);
      hero.addEventListener('focusout', resume);
      ScrollTrigger.create({ trigger: hero, start: 'top bottom', end: 'bottom top', onToggle: (s) => (s.isActive ? run.resume() : run.pause()) });
      cleanups.push(() => {
        marquee.removeEventListener('pointerenter', pause);
        marquee.removeEventListener('pointerleave', resume);
        hero.removeEventListener('focusin', pause);
        hero.removeEventListener('focusout', resume);
        track.querySelectorAll('[data-clone]').forEach((c) => c.remove());
        marquee.classList.remove('is-marquee');
      });
    }

    /* ---- Scroll cue: a slow pulse ---- */
    const pulse = hero.querySelector('[data-cue-pulse]');
    if (pulse) {
      const beat = gsap.fromTo(pulse, { scaleY: 0, transformOrigin: 'top' }, { scaleY: 1, duration: 1.6, ease: 'power2.inOut', repeat: -1, yoyo: true });
      ScrollTrigger.create({ trigger: hero, start: 'top bottom', end: 'bottom top', onToggle: (st) => (st.isActive ? beat.resume() : beat.pause()) });
    }

    /* ---- Desktop: pin + sheet slides over; hero scales to 0.94 and dims ---- */
    if (desktop) {
      const inner = q('[data-hero-inner]');
      // One trigger owns both the pin and the scale/dim, so they stay in step
      // (a second trigger on a pinned element measures it after pinning).
      gsap
        .timeline({
          scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', pin: true, pinSpacing: false, anticipatePin: 1, scrub: true },
        })
        .to(inner, { scale: 0.94, opacity: 0.35, ease: 'none' });
    }

    return () => cleanups.forEach((f) => f());
  });
</script>
