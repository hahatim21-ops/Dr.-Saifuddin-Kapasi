---
/**
 * Home §1 — Hero (Onda layout, Motion v4).
 * Built on the Onda studio template's hero: intro copy top-left, the giant
 * name bottom-left, and a large "aperture" on the right. Onda's aperture is a
 * purple ball that shrinks into the full stop of "Hello."; here it is the
 * prism, which shrinks into a brass triangle that is the full stop after
 * "Kapasi".
 * - Desktop (scrubbed): the orbit ring fades, the beam and spectrum go out,
 *   the glass fills with brass, and the prism travels and shrinks onto the
 *   full stop while the intro lifts away. The travelling prism (lib/prism.ts)
 *   then lifts off from that full stop ([data-hero-dock]) into the Manifesto.
 * - Phones, tablets, reduced motion and JS off: the prism stays in place and
 *   the full stop is a static brass triangle.
 * - Eyebrow rotates Educator · Author · Advisor · Speaker twice, then rests.
 * - Live "Mumbai · 21:27 IST" clock and the credibility marquee, as before.
 * Everything is visible in the HTML; GSAP sets start states at runtime only.
 * The intro waits for the loader (loader:done) when it is playing.
 * The name is the LCP element: it is never hidden before the engine runs. Its
 * letters rise only when the loader or the page curtain covers the page first;
 * only the words are split, so the full stop stays the element the shrink uses.
 */
import site from '../../data/site.json';
import Icon from '../Icon.astro';

const leadParts = site.heroLead.split(/(\*[^*]+\*)/).filter(Boolean);

// Prism geometry, shared with Prism.astro / PrismTraveller.astro.
const rays = [1, 2, 3, 4, 5, 6, 7];
const exit = { x: 206, y: 92 };
const endYs = [44, 60, 76, 92, 108, 124, 140];
const glass = 'M180 28 L 236 140 L 124 140 Z';
---

<section data-hero data-section="Introduction" class="hero" aria-labelledby="hero-title">
  <div class="hero__inner" data-hero-inner>
    <div class="hero__top container-content">
      <p class="hero__eyebrow" data-intro>
        <span class="hero__tri" aria-hidden="true"></span>
        <span class="sr-only">{site.heroRolesSr}</span>
        <span class="hero__roles" aria-hidden="true" data-roles>
          {site.heroRoles.map((r, i) => <span class:list={['hero__role', { 'is-active': i === 0 }]}>{r}</span>)}
        </span>
      </p>
      <p class="hero__clock" data-intro>
        <span>{site.clockCity}</span>
        <span aria-hidden="true">·</span>
        <time data-clock data-zone={site.clockZone}>{site.clockAbbr}</time>
      </p>
    </div>

    <div class="hero__intro container-content" data-hero-intro>
      <div class="hero__actions" data-intro data-hero-later>
        <a href="#books" class="btn btn-secondary">Explore the books</a>
      </div>
    </div>

    <!-- The aperture: Onda's purple ball, re-cast as the prism (decorative). -->
    <div class="hero__stage" data-hero-stage aria-hidden="true">
      <div class="hero__swell" data-hero-swell data-intro>
        <span class="hero__glow" data-hero-glow></span>
        <span class="hero__orbit" data-hero-orbit><span class="hero__moon"></span></span>
        <svg class="hero__prism" viewBox="0 0 400 180" fill="none" focusable="false">
          <g data-hero-beam>
            <path d="M0 112 L 150 98" class="hero__beam-halo"></path>
            <path d="M0 112 L 150 98" class="hero__beam" data-hero-draw></path>
          </g>
          <path d={glass} class="hero__glass"></path>
          <path d={`M150 98 L ${exit.x} ${exit.y}`} class="hero__inner-beam" data-hero-inner-beam></path>
          <g data-hero-spectrum>
            {rays.map((n, i) => (
              <path d={`M${exit.x} ${exit.y} L 400 ${endYs[i]}`} stroke={`var(--color-spectrum-${n})`} class="hero__ray" data-hero-ray></path>
            ))}
          </g>
          <path d={glass} class="hero__fill" data-hero-fill></path>
        </svg>
      </div>
    </div>

    <div class="hero__foot container-content">
      <h1 id="hero-title" class="hero__name" data-hero-name aria-label={site.heroName}><span class="hero__words" data-hero-words>{site.heroName}</span><span class="hero__period" data-hero-period aria-hidden="true"></span></h1>
      <p class="hero__lead" data-hero-lead data-intro>
        {leadParts.map((part) => (part.startsWith('*') ? <em class="accent">{part.slice(1, -1)}</em> : part))}
      </p>
    </div>

    <!-- Travelling-prism waypoint, moved onto the full stop at runtime (desktop):
         the prism docks here, hidden, and lifts off into the Manifesto. -->
    <span class="hero__dock" data-hero-dock data-prism-stop="hero" data-prism-opacity="0" data-prism-beam="0" data-prism-scale="0.35" data-prism-vy="0.15" aria-hidden="true"></span>

    <div class="hero__bottom" data-intro data-hero-later>
      <div class="hero__cred container-content">
        <p class="hero__cred-label">{site.credibilityLabel}</p>
        <div class="hero__marquee" data-marquee>
          <ul class="hero__track" role="list" data-marquee-track>
            {site.credibility.map((name) => <li>{name}</li>)}
          </ul>
        </div>
      </div>
      <a href="#arc" class="hero__cue" data-scroll-cue>
        <span>{site.scrollCue}</span>
        <span class="hero__cue-line" aria-hidden="true"><span data-cue-pulse></span></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 0; /* the sheet after it (DOM order) paints above */
    min-height: max(100svh, 560px);
    overflow-x: clip; /* the spectrum fans past the right edge */
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: max(100svh, 560px);
    padding-top: calc(4.75rem + env(safe-area-inset-top));
  }
  @media (min-width: 1024px) {
    .hero__inner {
      padding-top: calc(6rem + env(safe-area-inset-top));
    }
  }

  /* ---------- Top row: rotating eyebrow + clock ---------- */
  .hero__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .hero__eyebrow,
  .hero__clock {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-stone);
    font-variant-numeric: tabular-nums;
  }
  .hero__tri {
    width: 0.7em;
    height: 0.7em;
    background: var(--color-brass);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .hero__roles {
    display: inline-grid;
    overflow: hidden;
    height: 1.3em;
    line-height: 1.3;
  }
  .hero__role {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .hero__role.is-active {
    opacity: 1;
  }

  /* ---------- Intro (Onda: top-left) ---------- */
  .hero__intro {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 5svh, 3.5rem);
  }
  .hero__status {
    max-width: 30rem;
    display: grid;
    gap: 0.3rem;
  }
  .hero__status dt {
    display: inline;
    font-weight: 600;
  }
  .hero__status dd {
    display: inline;
    margin: 0 0 0 0.3em;
    color: var(--color-stone);
  }
  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  /* ---------- The aperture: prism, glow and orbit ring ---------- */
  .hero__stage {
    --ap: min(60vw, 30svh); /* phones: leave room for the name above the fold */
    position: relative;
    width: var(--ap);
    height: var(--ap);
    margin: clamp(1.5rem, 4svh, 3rem) auto 0;
    pointer-events: none;
  }
  .hero__swell {
    position: absolute;
    inset: 0;
  }
  .hero__glow {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    /* Pre-blurred glow (no filters): brass light behind the glass. */
    background: radial-gradient(closest-side, rgb(166 140 255 / 0.42), rgb(166 140 255 / 0.16) 55%, transparent 80%);
  }
  .hero__orbit {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    border: 1px solid var(--color-hairline);
  }
  .hero__moon {
    position: absolute;
    left: 50%;
    top: 0;
    width: 4.5%;
    height: 4.5%;
    margin: -2.25% 0 0 -2.25%;
    border-radius: 50%;
    background: var(--color-brass);
  }
  /* Orbit turns only while the hero is on screen and motion is allowed (JS adds .is-live). */
  @media (prefers-reduced-motion: no-preference) {
    .hero.is-live .hero__orbit {
      animation: hero-orbit 13s linear infinite;
    }
  }
  @keyframes hero-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  /* The SVG is 1.5× the aperture, placed so the glass (a 42% square) sits dead
     centre: the beam enters from outside the ring, the spectrum leaves it. */
  .hero__prism {
    position: absolute;
    left: -17.5%;
    top: 18.5%;
    width: 150%;
    max-width: none; /* the global svg cap would shrink it off-centre */
    height: auto;
    overflow: visible;
  }
  .hero__glass {
    stroke: var(--color-ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    fill: rgb(255 255 255 / 0.6);
    vector-effect: non-scaling-stroke;
  }
  .hero__fill {
    fill: var(--color-brass);
    stroke: var(--color-brass);
    stroke-width: 1.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: 0;
  }
  .hero__beam {
    stroke: var(--color-ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .hero__beam-halo {
    stroke: rgb(166 140 255 / 0.35);
    stroke-width: 7;
    stroke-linecap: round;
  }
  .hero__inner-beam {
    stroke: var(--color-brass);
    stroke-width: 1.25;
    opacity: 0.7;
    vector-effect: non-scaling-stroke;
  }
  .hero__ray {
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  /* ---------- Name (Onda: bottom-left, giant) + its brass full stop ---------- */
  .hero__foot {
    margin-top: auto;
    padding-top: clamp(1.5rem, 4svh, 3rem);
  }
  .hero__name {
    position: relative;
    z-index: 2;
    max-width: 4.6em; /* always two lines: "Saifuddin / Kapasi" */
    padding-bottom: 0.12em; /* room for the descender of "p" above the lead */
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(3.5rem, 20vw, 9rem);
    line-height: 0.86;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .hero__period {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    margin-left: 0.06em;
    background: var(--color-brass);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    vertical-align: baseline;
  }
  .hero__lead {
    margin-top: clamp(0.75rem, 2svh, 1.25rem);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.15;
    max-width: 26ch;
    text-wrap: balance;
  }
  .hero__dock {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* ---------- Bottom: credibility marquee + scroll cue ---------- */
  .hero__bottom {
    position: relative;
    margin-top: clamp(1.25rem, 3svh, 2rem);
    padding-bottom: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }
  .hero__cred {
    display: grid;
    gap: 0.35rem;
    padding-top: 1rem;
    font-size: var(--text-small);
    color: var(--color-stone);
  }
  .hero__cred-label {
    font-weight: 600;
    color: var(--color-ink);
  }
  .hero__marquee {
    overflow: hidden;
  }
  .hero__track {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero__track li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.75rem;
  }
  .hero__marquee.is-marquee .hero__track {
    flex-wrap: nowrap;
    width: max-content;
  }
  .hero__marquee.is-marquee .hero__track li::after {
    content: '·';
    margin-inline: 0.75rem;
  }
  .hero__cue {
    display: none;
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: var(--color-hairline);
    overflow: hidden;
  }
  .hero__cue-line span {
    position: absolute;
    inset: 0;
    background: var(--color-brass);
    transform-origin: top;
  }

  /* ---------- Desktop (Onda landscape): aperture on the right ---------- */
  @media (min-width: 1024px) {
    .hero__stage {
      --ap: min(32vw, 48svh, 30rem);
      position: absolute;
      right: calc(max(var(--gutter), (100vw - 75rem) / 2) + 3vw);
      top: calc(50% - var(--ap) / 2 - 1.5rem);
      margin: 0;
    }
    .hero__name {
      font-size: min(13vw, 22svh, 11.5rem); /* clears the ring up to 1920 */
    }
    .hero__cred {
      padding-right: 8rem; /* the scroll cue sits at the right end */
    }
    .hero__cue {
      position: absolute;
      right: max(var(--gutter), calc((100vw - 75rem) / 2));
      bottom: 1.75rem;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      min-height: 2.75rem;
      font-size: var(--text-eyebrow);
      font-weight: 600;
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--color-stone);
      text-decoration: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, SplitText, registerScene, afterCurtain } from '../../lib/tools';
  import { GS } from '../../lib/motion';

  /**
   * Live local clock: "21:27 IST", refreshed every 20s. Runs in every context,
   * but only while it is on screen and the tab is visible (Motion v3).
   */
  function startClock(el: HTMLElement) {
    const zone = el.dataset.zone || 'Asia/Kolkata';
    const abbr = el.textContent?.trim() || 'IST';
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: zone });
    const tick = () => {
      const now = new Date();
      el.textContent = `${fmt.format(now)} ${abbr}`;
      el.setAttribute('datetime', now.toISOString());
    };
    let id = 0;
    let onScreen = true;
    const sync = () => {
      const run = onScreen && document.visibilityState === 'visible';
      if (run && !id) {
        tick();
        id = window.setInterval(tick, 20000);
      } else if (!run && id) {
        window.clearInterval(id);
        id = 0;
      }
    };
    const io = new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      sync();
    });
    io.observe(el);
    document.addEventListener('visibilitychange', sync);
    sync();
    return () => {
      io.disconnect();
      document.removeEventListener('visibilitychange', sync);
      window.clearInterval(id);
      el.textContent = abbr;
    };
  }

  /** Layout position of el inside ancestor (offsets ignore transforms). */
  function offsetIn(el: HTMLElement, ancestor: HTMLElement) {
    let x = 0;
    let y = 0;
    let n: HTMLElement | null = el;
    while (n && n !== ancestor) {
      x += n.offsetLeft;
      y += n.offsetTop;
      n = n.offsetParent as HTMLElement | null;
    }
    return { x, y };
  }

  /** The glass is a centred square, 42% of the aperture (see .hero__prism). */
  const GLASS = 0.42;
  /** Glass width of the travelling prism at scale 1 (360px × 112/400). */
  const FLY_GLASS = 360 * (112 / 400);

  registerScene('hero', ({ reduce, desktop }) => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const cleanups: Array<() => void> = [];
    const clock = hero.querySelector<HTMLElement>('[data-clock]');
    if (clock) cleanups.push(startClock(clock));
    if (reduce) return () => cleanups.forEach((f) => f());

    const q = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s)!;
    const lead = q('[data-hero-lead]');
    const swell = q('[data-hero-swell]');
    const draws = hero.querySelectorAll<SVGPathElement>('[data-hero-draw], [data-hero-inner-beam], [data-hero-ray]');
    const rays = hero.querySelectorAll<SVGPathElement>('[data-hero-ray]');
    const beamLines = hero.querySelectorAll<SVGPathElement>('[data-hero-draw], [data-hero-inner-beam]');
    const later = hero.querySelectorAll('[data-hero-later]');
    const top = hero.querySelectorAll('.hero__top [data-intro]');
    const nav = document.querySelector('[data-intro-nav]');

    /* ---- Intro timeline (paused until the loader is done) ---- */
    // The name is the LCP element, so it is never hidden before the engine runs.
    // Its letters rise only when something covers the page first (the loader on
    // a first visit, the curtain on a page change); on a return visit it just stands.
    const html = document.documentElement;
    const covered = !!(html.dataset.loaderState || html.dataset.curtainState);
    // Split only the words: the full stop must stay the same element, because the
    // shrink below is bound to it (a revert would otherwise replace it).
    const nameSplit = covered ? SplitText.create(q('[data-hero-words]'), { type: 'words,chars', mask: 'words', aria: 'none' }) : null;
    const tl = gsap.timeline({
      paused: true,
      defaults: { ease: GS.ease.reveal },
      onComplete: () => {
        // Hand the text back to the browser so later resizes reflow naturally.
        nameSplit?.revert();
        gsap.set(draws, { clearProps: 'strokeDasharray,strokeDashoffset' });
        // The full stop may sit a pixel or two differently once the split is gone.
        ScrollTrigger.refresh();
      },
    });
    // Onda's "swell": the aperture grows in with a slight overshoot while the
    // name rises; then the beam draws in and the spectrum fans out.
    if (nameSplit) tl.from(nameSplit.chars, { yPercent: 110, duration: 1.1, stagger: GS.stagger.chars }, 0.1);
    tl.from(swell, { scale: 0.6, autoAlpha: 0, duration: 1.1, ease: 'back.out(1.3)' }, 0.15)
      .fromTo(beamLines, { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.6, ease: 'power2.inOut', stagger: 0.2 }, 0.55)
      .fromTo(rays, { drawSVG: '0%' }, { drawSVG: '100%', duration: 0.6, ease: 'power2.out', stagger: 0.06 }, 0.95)
      .from(top, { autoAlpha: 0, y: 12, duration: GS.dur.body, stagger: { amount: 0.2 } }, 0.35)
      .from(lead, { autoAlpha: 0, y: 16, duration: GS.dur.body }, 0.45)
      .from(later, { autoAlpha: 0, y: 16, duration: GS.dur.body, stagger: { amount: 0.3 } }, 0.6);
    if (nav) tl.from(nav, { autoAlpha: 0, y: -8, duration: 0.8 }, 1.0);

    // Never under the loader or the page-transition curtain (Motion v3).
    const play = () =>
      afterCurtain(() => {
        tl.play();
        ScrollTrigger.refresh();
      });
    if (document.documentElement.dataset.loaderState) {
      document.addEventListener('loader:done', play, { once: true });
      cleanups.push(() => document.removeEventListener('loader:done', play));
    } else play();

    /* ---- Idle loops run only while the hero is on screen ---- */
    ScrollTrigger.create({
      trigger: hero,
      start: 'top bottom',
      end: 'bottom top',
      onToggle: (s) => hero.classList.toggle('is-live', s.isActive),
    });
    cleanups.push(() => hero.classList.remove('is-live'));

    /* ---- Rotating eyebrow: two cycles, then it rests on the first role ---- */
    const roles = [...hero.querySelectorAll<HTMLElement>('.hero__role')];
    if (roles.length > 1) {
      let i = 0;
      gsap.set(roles, { opacity: 1, yPercent: (k: number) => (k === 0 ? 0 : 110) });
      const swap = () => {
        const cur = roles[i];
        i = (i + 1) % roles.length;
        const next = roles[i];
        gsap.to(cur, { yPercent: -110, duration: 0.7, ease: GS.ease.strong });
        gsap.fromTo(next, { yPercent: 110 }, { yPercent: 0, duration: 0.7, ease: GS.ease.strong });
      };
      const swaps = roles.length * 2; // ends back on roles[0]
      const loop = gsap.timeline({ repeat: swaps - 1, delay: 2.5 }).call(swap).to({}, { duration: 2.5 });
      ScrollTrigger.create({ trigger: hero, start: 'top bottom', end: 'bottom top', onToggle: (s) => (s.isActive ? loop.resume() : loop.pause()) });
    }

    /* ---- Credibility marquee (stops on hover / focus / off-screen) ---- */
    const marquee = hero.querySelector<HTMLElement>('[data-marquee]');
    const track = marquee?.querySelector<HTMLElement>('[data-marquee-track]');
    if (marquee && track) {
      const originals = [...track.children];
      originals.forEach((li) => {
        const c = li.cloneNode(true) as HTMLElement;
        c.setAttribute('aria-hidden', 'true');
        c.dataset.clone = '';
        track.append(c);
      });
      marquee.classList.add('is-marquee');
      const run = gsap.to(track, { xPercent: -50, duration: 38, ease: 'none', repeat: -1 });
      const pause = () => run.pause();
      const resume = () => run.resume();
      marquee.addEventListener('pointerenter', pause);
      marquee.addEventListener('pointerleave', resume);
      hero.addEventListener('focusin', pause);
      hero.addEventListener('focusout', resume);
      ScrollTrigger.create({ trigger: hero, start: 'top bottom', end: 'bottom top', onToggle: (s) => (s.isActive ? run.resume() : run.pause()) });
      cleanups.push(() => {
        marquee.removeEventListener('pointerenter', pause);
        marquee.removeEventListener('pointerleave', resume);
        hero.removeEventListener('focusin', pause);
        hero.removeEventListener('focusout', resume);
        track.querySelectorAll('[data-clone]').forEach((c) => c.remove());
        marquee.classList.remove('is-marquee');
      });
    }

    /* ---- Scroll cue: a slow pulse ---- */
    const pulse = hero.querySelector('[data-cue-pulse]');
    if (pulse) {
      const beat = gsap.fromTo(pulse, { scaleY: 0, transformOrigin: 'top' }, { scaleY: 1, duration: 1.6, ease: 'power2.inOut', repeat: -1, yoyo: true });
      ScrollTrigger.create({ trigger: hero, start: 'top bottom', end: 'bottom top', onToggle: (st) => (st.isActive ? beat.resume() : beat.pause()) });
    }

    /* ---- Desktop: the prism shrinks into the full stop (Onda's aperture) ---- */
    if (desktop) {
      const stage = q('[data-hero-stage]');
      const period = q('[data-hero-period]');
      const dock = q('[data-hero-dock]');
      const intro = q('[data-hero-intro]');

      // Where the full stop is, relative to the aperture's centre, and how
      // small the glass must get to match it. Read fresh each time: the name
      // is split and reverted by the intro.
      const geo = () => {
        const p = hero.querySelector<HTMLElement>('[data-hero-period]')!;
        const s = offsetIn(stage, hero);
        const f = offsetIn(p, hero);
        const ap = stage.offsetWidth;
        const ps = p.offsetWidth;
        return { x: f.x + ps / 2 - (s.x + ap / 2), y: f.y + ps / 2 - (s.y + ap / 2), scale: ps / (ap * GLASS) };
      };
      // The travelling prism's first waypoint sits on the full stop; it docks
      // there (hidden) at the very scroll where this timeline ends, then lifts off.
      const placeDock = () => {
        const p = hero.querySelector<HTMLElement>('[data-hero-period]')!;
        const f = offsetIn(p, hero);
        const ps = p.offsetWidth;
        Object.assign(dock.style, { left: `${f.x}px`, top: `${f.y}px`, width: `${ps}px`, height: `${ps}px` });
        dock.dataset.prismScale = (ps / FLY_GLASS).toFixed(3);
      };
      placeDock();
      ScrollTrigger.addEventListener('refreshInit', placeDock);

      gsap.set(period, { autoAlpha: 0 }); // the shrunken prism becomes the full stop
      const shrink = gsap.timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          endTrigger: period,
          end: 'center 15%', // = the dock's data-prism-vy
          scrub: GS.scrub,
          invalidateOnRefresh: true,
        },
      });
      shrink
        .to(stage, { x: () => geo().x, y: () => geo().y, duration: 1, ease: 'power1.inOut' }, 0)
        .to(stage, { scale: () => geo().scale, duration: 1, ease: 'power3.in' }, 0)
        .to(q('[data-hero-orbit]'), { autoAlpha: 0, duration: 0.3 }, 0)
        .to(q('[data-hero-glow]'), { autoAlpha: 0, duration: 0.5 }, 0)
        .to(intro, { y: -70, duration: 1, ease: 'power1.inOut' }, 0)
        .to([q('[data-hero-beam]'), q('[data-hero-inner-beam]'), q('[data-hero-spectrum]')], { autoAlpha: 0, duration: 0.55 }, 0.1)
        .to(q('[data-hero-fill]'), { opacity: 1, duration: 0.6, ease: 'power1.in' }, 0.3);

      cleanups.push(() => {
        ScrollTrigger.removeEventListener('refreshInit', placeDock);
        gsap.set(period, { clearProps: 'all' });
        dock.removeAttribute('style');
      });
    }

    return () => cleanups.forEach((f) => f());
  });
</script>
