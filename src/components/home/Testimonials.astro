---
/**
 * Home §9 — What people say. Others do the praising (BRIEF §2): one large
 * centred serif quote at a time (Testimonials island). Named quotes only appear
 * once `permission: true`; placeholders are shown for review and tagged.
 *
 * Motion v4 (Onda's "again" wheel), desktop with a fine pointer and motion
 * allowed: all quotes are green cards on a large wheel inside a sticky stage.
 * As the section arrives the heading rises (45% → 0) and the wheel swings up
 * into place; then scrolling turns the wheel so the cards pass right to left
 * (0.42 screens of scroll per card). Only transforms animate. Every quote is
 * in the HTML as a plain list in reading order — nothing to operate, nothing
 * rotates on its own — so keyboard and screen-reader users simply read it.
 * JS off on desktop: the same cards as a grid. Phones, tablets and reduced
 * motion: the Testimonials island as before (one quote at a time, pausable).
 */
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import Testimonials, { type Quote } from '../../islands/Testimonials.tsx';
import SectionHeader from '../SectionHeader.astro';
import AchievementLightbox from '../../islands/AchievementLightbox.tsx';
import { toAchievements } from '../../lib/achievements';

const quotes: Quote[] = (await getCollection('testimonials'))
  // Real quotes need permission; placeholders stay visible until replaced.
  .filter((t) => t.data.permission || t.data.placeholder)
  .map((t) => ({
    id: t.id,
    quote: t.data.quote,
    name: t.data.name,
    role: t.data.role,
    placeholder: t.data.placeholder,
  }));
const t = home.testimonials;
const a = home.achievements;
// Motion v3: the three newest featured frames (the full wall is on /about#recognition).
const recent = await toAchievements(
  (await getCollection('achievements'))
    .filter((x) => x.data.featured)
    .sort((x, y) => y.data.date.getTime() - x.data.date.getTime())
    .slice(0, 3)
);
---

<section id="testimonials" class="testimonials" aria-labelledby="testimonials-title" data-tw-section>
  <div class="tw" data-tw>
    <div class="tw__stage" data-tw-stage>
      <div class="container-content tw__head" data-tw-head>
        <SectionHeader eyebrow={t.eyebrow} id="testimonials-title" title={t.title} center />
      </div>
      {
        quotes.length > 0 && (
          <>
            {/* Desktop: Onda's wheel (a grid when JS is off). */}
            <div class="tw__swing" data-tw-swing>
              <ul class="tw__wheel" role="list" aria-label={t.carouselLabel} data-tw-wheel>
                {quotes.map((q, i) => (
                  <li class="tw__item" style={`--i:${i}`} data-tw-item>
                    <figure class="tw__card">
                      <svg class="tw__mark" viewBox="0 0 92 64" aria-hidden="true" focusable="false">
                        <path d="M30 6 C16 13 7 25 7 40 C7 51 13 58 22 58 C30 58 36 52 36 44 C36 36 30 31 23 31 C20 31 18 32 17 33 C18 24 24 16 33 11 Z" />
                        <path d="M76 6 C62 13 53 25 53 40 C53 51 59 58 68 58 C76 58 82 52 82 44 C82 36 76 31 69 31 C66 31 64 32 63 33 C64 24 70 16 79 11 Z" />
                      </svg>
                      <blockquote class="tw__quote">
                        <p>{q.quote}</p>
                      </blockquote>
                      <figcaption class="tw__by">
                        <span class="tw__name">{q.name}</span>
                        <span class="tw__role">{q.role}</span>
                        {q.placeholder && <span class="placeholder-tag">{t.placeholderLabel}</span>}
                      </figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            </div>
            {/* Phones, tablets, reduced motion: one quote at a time. */}
            <div class="container-content tw__island">
              <div class="testimonials__body" data-reveal>
                <Testimonials client:visible={{ rootMargin: '300px' }} quotes={quotes} label={t.carouselLabel} placeholderLabel={t.placeholderLabel} />
              </div>
            </div>
          </>
        )
      }
    </div>
  </div>

  <div class="container-content">
    <div class="recog">
      <div class="recog__head">
        <h3 class="recog__title">{a.eyebrow}</h3>
        <a href={a.seeAllHref} class="recog__all link-grow-line">
          {a.seeAll} <span aria-hidden="true">→</span>
        </a>
      </div>
      <AchievementLightbox client:visible={{ rootMargin: '300px' }} items={recent} label={a.wallLabel} placeholderLabel={a.placeholderLabel} />
    </div>
  </div>
</section>

<style>
  /* Recognition row (3 newest frames). */
  .recog {
    margin-top: clamp(4rem, 3rem + 4vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-hairline);
  }
  .recog__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .recog__title {
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-stone);
  }
  .recog__all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-green);
  }

  .testimonials {
    padding-block: var(--section-space);
    border-top: 1px solid var(--color-hairline);
  }
  /* ---------- Onda's wheel (desktop) ---------- */
  .tw__swing {
    display: none;
  }
  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .tw__island {
      display: none;
    }
    /* Without JS: the cards as a grid. */
    .tw__swing {
      display: block;
      max-width: calc(var(--container-content) + 2 * var(--gutter));
      margin: clamp(2.5rem, 7vh, 4.5rem) auto 0;
      padding-inline: var(--gutter);
    }
    .tw__wheel {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
  .tw__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin: 0;
    aspect-ratio: 4 / 5; /* grows if a quote is long */
    padding: clamp(1.4rem, 2vw, 2rem);
    border-radius: 20px;
    background-color: var(--color-green);
    background-image: var(--grain);
    color: var(--color-ivory);
    box-shadow: 0 18px 40px -24px rgb(28 31 30 / 0.5);
  }
  .tw__mark {
    width: 3.25rem;
    height: auto;
    fill: var(--color-brass-light);
  }
  .tw__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.375rem, 0.9rem + 0.9vw, 1.875rem);
    line-height: 1.22;
    text-wrap: pretty;
  }
  .tw__by {
    display: grid;
    justify-items: start;
    gap: 0.2rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-hairline-on-green);
  }
  .tw__name {
    font-weight: 600;
  }
  .tw__role {
    color: rgb(246 241 231 / 0.78);
  }
  .tw__by .placeholder-tag {
    margin-top: 0.5rem;
    color: var(--color-brass-light);
    border-color: var(--color-brass-light);
  }
  /* Live (the scene measured the wheel): Onda's sticky stage. */
  .testimonials.is-wheel {
    padding-top: 0;
  }
  .tw.is-live {
    height: calc(100svh + var(--spin, 0px));
  }
  .tw.is-live .tw__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: clip;
    padding-top: clamp(6rem, 13svh, 8rem); /* clears the nav bar */
  }
  .tw.is-live .tw__swing {
    position: absolute;
    left: 50%;
    top: calc(var(--arc-top) + var(--radius));
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
  }
  .tw.is-live .tw__wheel {
    position: absolute;
    left: 0;
    top: 0;
    display: block;
    width: 0;
    height: 0;
  }
  .tw.is-live .tw__item {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    transform: rotate(calc(var(--i) * var(--step)));
  }
  .tw.is-live .tw__card {
    position: absolute;
    left: calc(var(--card) / -2);
    top: calc(var(--radius) * -1);
    width: var(--card);
  }

  .testimonials__body {
    max-width: 56rem;
    margin: clamp(2.5rem, 2rem + 3vw, 4rem) auto 0;
  }

  /* ----- island markup (classes rendered by Testimonials.tsx) ----- */
  .testimonials :global(.tq__stage) {
    display: grid;
    touch-action: pan-y; /* vertical page scroll stays native; we read horizontal swipes */
  }
  .testimonials :global(.tq__slide) {
    grid-area: 1 / 1;
    margin: 0;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 700ms var(--ease),
      visibility 0s linear 700ms;
  }
  .testimonials :global(.tq__slide.is-active) {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 700ms var(--ease),
      visibility 0s;
  }
  /* Big brass quote mark: outlines draw, then the fill settles in (GSAP). */
  .testimonials :global(.tq__mark) {
    display: block;
    width: clamp(3.75rem, 3rem + 3vw, 5.5rem);
    height: auto;
    margin: 0 auto 1.25rem;
    overflow: visible;
  }
  .testimonials :global(.tq__mark path) {
    fill: var(--color-brass);
    stroke: var(--color-brass);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }
  .testimonials :global(.tq__quote) {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.35rem + 1.7vw, 2.75rem); /* 28 → 44px */
    line-height: 1.25;
    text-wrap: balance;
  }
  .testimonials :global(.tq__by) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    margin-top: 1.75rem;
  }
  .testimonials :global(.tq__name) {
    font-weight: 600;
  }
  .testimonials :global(.tq__role) {
    color: var(--color-stone);
  }
  .testimonials :global(.tq__by .placeholder-tag) {
    margin-top: 0.5rem;
  }

  .testimonials :global(.tq__controls) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .testimonials :global(.tq__btn) {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    color: var(--color-green);
    cursor: pointer;
    transition:
      background-color var(--dur-tap) var(--ease),
      color var(--dur-tap) var(--ease),
      border-color var(--dur-tap) var(--ease);
  }
  .testimonials :global(.tq__btn:hover) {
    border-color: var(--color-green);
  }
  .testimonials :global(.tq__btn--pause) {
    position: relative;
    margin-left: 0.75rem;
  }
  /* 8s timer ring around the pause button. */
  .testimonials :global(.tq__ring) {
    position: absolute;
    inset: -3px;
    width: calc(100% + 6px);
    height: calc(100% + 6px);
    transform: rotate(-90deg);
    pointer-events: none;
    overflow: visible;
  }
  .testimonials :global(.tq__ring circle) {
    fill: none;
    stroke: var(--color-brass);
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation-name: tq-ring;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
  }
  @keyframes tq-ring {
    to {
      stroke-dashoffset: 0;
    }
  }
  .testimonials :global(.tq__dots) {
    display: flex;
  }
  .testimonials :global(.tq__dot) {
    display: grid;
    place-items: center;
    width: 2.75rem; /* 44px hit area around a small dot */
    height: 2.75rem;
    cursor: pointer;
  }
  .testimonials :global(.tq__dot span) {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-hairline);
    box-shadow: inset 0 0 0 1px rgb(28 31 30 / 0.25);
    transition:
      transform var(--dur-tap) var(--ease),
      background-color var(--dur-tap) var(--ease);
  }
  .testimonials :global(.tq__dot[aria-current='true'] span) {
    background: var(--color-green);
    box-shadow: none;
    transform: scale(1.25);
  }
  @media (max-width: 479.98px) {
    .testimonials :global(.tq__dot) {
      width: 2.25rem;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, registerScene } from '../../lib/tools';
  import { GS } from '../../lib/motion';

  const WHEEL = '(min-width: 1024px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)';

  registerScene('testimonials-wheel', ({ desktop, reduce }) => {
    const section = document.querySelector<HTMLElement>('[data-tw-section]');
    const tw = section?.querySelector<HTMLElement>('[data-tw]');
    const stage = tw?.querySelector<HTMLElement>('[data-tw-stage]');
    const head = tw?.querySelector<HTMLElement>('[data-tw-head]');
    const swing = tw?.querySelector<HTMLElement>('[data-tw-swing]');
    const wheel = tw?.querySelector<HTMLElement>('[data-tw-wheel]');
    if (!section || !tw || !stage || !head || !swing || !wheel) return;
    if (reduce || !desktop || !matchMedia(WHEEL).matches) return;
    const count = wheel.querySelectorAll('[data-tw-item]').length;
    if (count < 2) return;

    section.classList.add('is-wheel');
    tw.classList.add('is-live');

    // Onda's geometry (its scene-script "again"), measured on every refresh.
    const g = { from: 0, to: 0, swingR: 0, swingY: 0 };
    const measure = () => {
      const width = window.innerWidth;
      const height = stage.offsetHeight;
      const headBottom = head.offsetTop + head.offsetHeight;
      const room = height - headBottom - window.innerHeight * 0.04;
      const card = Math.max(180, Math.min(width * 0.28, (room - 32) / 1.25));
      const arcTop = headBottom + Math.max(28, (room - card * 1.25) * 0.4);
      const radius = Math.max(width * 0.95, card * 3.3);
      const step = (2 * Math.asin((card + Math.max(18, width * 0.024)) / (2 * radius)) * 180) / Math.PI;
      g.from = step * 0.55;
      g.to = -(count - 0.45) * step;
      g.swingR = Math.max(4, (Math.asin(Math.min(1, (width * 0.3) / radius)) * 180) / Math.PI - step * 0.55);
      // Onda drops the wheel in from above (-(arcTop - 40)); with our centred
      // heading that crosses the title, so here it rises into place from below.
      g.swingY = window.innerHeight * 0.3;
      const set = (k: string, v: string) => tw.style.setProperty(k, v);
      set('--card', `${card.toFixed(1)}px`);
      set('--radius', `${radius.toFixed(1)}px`);
      set('--step', `${step.toFixed(3)}deg`);
      set('--arc-top', `${arcTop.toFixed(1)}px`);
      set('--spin', `${Math.round(count * window.innerHeight * 0.42)}px`);
    };
    measure();
    ScrollTrigger.addEventListener('refreshInit', measure);

    // Scroll positions in px; enter = the block's top meets the bottom of the screen.
    const top = () => tw.getBoundingClientRect().top + window.scrollY;
    const enter = () => top() - window.innerHeight;
    const arrive = () => enter() + window.innerHeight * 0.7; // Onda: cover 0 → 70vh
    const leave = () => top() + tw.offsetHeight - window.innerHeight;

    // The heading rises and the wheel swings up into place (from below, so it never crosses the title) as it arrives.
    gsap.fromTo(
      head,
      { yPercent: 45 },
      { yPercent: 0, ease: 'power2.out', scrollTrigger: { start: enter, end: arrive, scrub: true, invalidateOnRefresh: true } }
    );
    gsap
      .timeline({ scrollTrigger: { start: enter, end: arrive, scrub: true, invalidateOnRefresh: true } })
      .fromTo(swing, { rotation: () => g.swingR }, { rotation: 0, ease: 'power1.out' }, 0)
      .fromTo(swing, { y: () => g.swingY }, { y: 0, ease: 'power2.out' }, 0);
    // The turning wheel is a lot of textured card to repaint each frame, so it
    // gets its own layer — but only while the block is on screen.
    ScrollTrigger.create({
      start: enter,
      end: () => top() + tw.offsetHeight,
      onToggle: (self) => gsap.set([swing, wheel], { willChange: self.isActive ? 'transform' : 'auto' }),
    });
    // Then the wheel turns: the cards pass from right to left.
    gsap.fromTo(
      wheel,
      { rotation: () => g.from },
      { rotation: () => g.to, ease: 'none', scrollTrigger: { start: arrive, end: leave, scrub: GS.scrub, invalidateOnRefresh: true } }
    );

    return () => {
      ScrollTrigger.removeEventListener('refreshInit', measure);
      section.classList.remove('is-wheel');
      tw.classList.remove('is-live');
      ['--card', '--radius', '--step', '--arc-top', '--spin'].forEach((k) => tw.style.removeProperty(k));
      gsap.set([head, swing, wheel], { clearProps: 'transform,willChange' });
    };
  });
</script>
