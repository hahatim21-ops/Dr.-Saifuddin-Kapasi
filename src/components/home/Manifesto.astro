---
/**
 * Home §2 — Manifesto (new). A green band whose top edge is the inflection
 * line: it is the "sheet" that slides over the pinned hero, starting flat and
 * bending upward as it arrives.
 * - Desktop: pinned for ~100vh; each word scrubs from dim light brass to full
 *   ivory, with the travelling prism docked large behind the words.
 * - Phones: no pin; the words light up as the paragraph passes through.
 * Only opacity animates: a dim, aria-hidden brass copy of the text sits under
 * the real (ivory) text, whose words fade from 0 to 1. With JS off or reduced
 * motion the real text is simply fully visible.
 *
 * Motion v4 (Onda's "statement"): the quote is set as its two clauses. As the
 * band arrives (desktop), clause 1 slides in from (-6%, 85%) and clause 2 from
 * (9%, 85%), 8.4vh later; both land before the pin starts, so they never fight
 * the word light-up. The full stop is the hero's brass triangle; it scales in
 * once the last word has lit. Phones: no slides, the triangle scales in at the
 * end of the light-up.
 */
import home from '../../data/home.json';
import Eyebrow from '../Eyebrow.astro';
import InflectionEdge from '../InflectionEdge.astro';

const m = home.manifesto;
// The two clauses ("…by chance," / "they are … designed"); the closing full
// stop is drawn as the brass triangle instead of a glyph.
const quote = m.quote.replace(/\.\s*$/, '');
const cut = quote.indexOf(', ');
const clauses = cut > 0 ? [quote.slice(0, cut + 1), quote.slice(cut + 2)] : [quote];
---

<div class="mani-sheet" data-sheet>
  <InflectionEdge class="mani-edge" />
  <section id="manifesto" class="mani on-green" aria-labelledby="mani-title" data-section={m.eyebrow}>
    <!-- Prism waypoint on the (unpinned) section, at the middle of the first screen
         (where the pinned content sits while it is held for 100vh). It spans the
         content column and the prism docks near its right edge, so the glass and
         the beam stay clear of the quote at every desktop width. -->
    <span class="container-content mani__stop" data-prism-stop="manifesto" data-prism-scale="1.9" data-prism-beam="0.55" data-prism-beam-to="1" data-prism-hold="100" data-prism-anchor="right" data-prism-dx="-190" aria-hidden="true"></span>
    <div class="mani__pin" data-mani-pin>
      <div class="container-content mani__inner">
        <h2 id="mani-title" class="sr-only">{m.eyebrow}</h2>
        <Eyebrow as="p">{m.eyebrow}</Eyebrow>
        <blockquote class="mani__quote">
          <p class="mani__ghost" aria-hidden="true">
            {clauses.map((c, i) => (
              <span class="mani__line" data-mani-line={i}>
                {c}
                {i === clauses.length - 1 && <span class="mani__dot is-ghost" />}
              </span>
            ))}
          </p>
          <p class="mani__text" data-mani-text>
            {clauses.map((c, i) => (
              <span class="mani__line" data-mani-line={i}>
                {c}
                {i === clauses.length - 1 && <span class="mani__dot" data-mani-dot aria-hidden="true" />}
              </span>
            ))}
          </p>
          <footer class="mani__by">— {m.attribution}</footer>
        </blockquote>
        <p class="mani__signoff">{m.signOff}</p>
      </div>
    </div>
    <!-- Way out: the ivory Arc rises into the green along the inflection curve. -->
    <InflectionEdge color="var(--color-ivory)" class="band-out" />
  </section>
</div>

<style>
  /* The sheet here is the edge + band, not a rounded ivory card. */
  .mani-sheet[data-sheet] {
    background: none;
    border-radius: 0;
    box-shadow: none;
    /* No stacking context here, so the words (z 6) can sit above the travelling
       prism (z 4) while the green band stays below it. */
    z-index: auto;
  }
  .mani-sheet :global(.mani-edge) {
    filter: drop-shadow(0 -14px 22px rgb(13 12 17 / 0.18));
  }
  .mani {
    position: relative;
    background-color: var(--color-green);
    color: var(--color-ivory);
  }
  .mani__pin {
    /* GSAP makes this position: fixed while pinned, which creates a stacking
       context: its own z-index keeps the words above the prism layer (z 4). */
    position: relative;
    z-index: 6;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: clamp(4rem, 3rem + 6vw, 8rem);
  }
  .mani__inner {
    position: relative;
    z-index: 6; /* above the prism layer: the prism glows behind the words */
  }
  .mani__stop {
    position: absolute;
    inset-inline: 0;
    top: 50vh;
    display: block;
    height: 1px;
  }
  .mani__quote {
    position: relative;
    margin: 1.75rem 0 0;
  }
  .mani__text,
  .mani__ghost {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.25rem, 1.2rem + 4.6vw, 6rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    max-width: 17ch;
    text-wrap: balance;
  }
  .mani__text {
    position: relative;
    color: var(--color-ivory);
  }
  .mani__line {
    display: block;
  }
  /* The hero's brass triangle full stop. */
  .mani__dot {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    margin-left: 0.06em;
    background: var(--color-brass-light);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    transform-origin: 50% 80%;
  }
  .mani__dot.is-ghost {
    visibility: hidden; /* keeps the dim copy wrapping exactly like the text */
  }
  /* The dim layer the ivory words light up over (only seen once JS hides them). */
  .mani__ghost {
    position: absolute;
    inset: 0 auto auto 0;
    color: var(--color-brass-light);
    opacity: 0.22;
  }
  .mani__by {
    margin-top: 1.5rem;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-brass-light);
  }
  .mani__signoff {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-brass-light);
  }
</style>

<script>
  import { gsap, splitText, registerScene } from '../../lib/tools';
  import type { ScrollTrigger } from 'gsap/ScrollTrigger';

  registerScene('manifesto', ({ reduce, desktop }) => {
    const section = document.querySelector<HTMLElement>('#manifesto');
    if (!section || reduce) return;
    const text = section.querySelector<HTMLElement>('[data-mani-text]')!;
    const pin = section.querySelector<HTMLElement>('[data-mani-pin]')!;

    // Words (not lines), so wrapping changes don't matter; aria keeps the sentence whole.
    const dot = section.querySelector<HTMLElement>('[data-mani-dot]');
    const split = splitText(text, { type: 'words' });
    gsap.set(split.words, { opacity: 0 });
    if (dot) gsap.set(dot, { scale: 0 });

    // The words light up one after another; the brass full stop lands last.
    const lightUp = (scrollTrigger: ScrollTrigger.Vars) => {
      const tl = gsap.timeline({ defaults: { ease: 'none' }, scrollTrigger });
      tl.to(split.words, { opacity: 1, stagger: 0.1 }, 0);
      if (dot) tl.to(dot, { scale: 1, duration: 0.35, ease: 'back.out(2)' });
      return tl;
    };

    if (desktop) {
      // Onda's statement: the two clauses slide in from opposite sides while
      // the band arrives (Onda: cover 0 → 56vh, the second 8.4vh later).
      const enter = () => section.getBoundingClientRect().top + window.scrollY - window.innerHeight;
      const lines = [0, 1].map((i) => section.querySelectorAll<HTMLElement>(`[data-mani-line="${i}"]`));
      const from = [{ xPercent: -6, yPercent: 85 }, { xPercent: 9, yPercent: 85 }];
      lines.forEach((pair, i) => {
        if (!pair.length) return;
        gsap.fromTo(pair, from[i], {
          xPercent: 0,
          yPercent: 0,
          ease: 'power2.out', // Onda: cubic-bezier(.333, 1, .667, 1)
          scrollTrigger: {
            trigger: section,
            // In scroll px: the band's top enters at the bottom of the screen = 0.
            start: () => enter() + window.innerHeight * 0.084 * i,
            end: () => enter() + window.innerHeight * (0.56 + 0.084 * i),
            scrub: true,
            invalidateOnRefresh: true,
          },
        });
      });
      // Pinned ~100vh: the words light up across the pin.
      lightUp({
        trigger: pin,
        start: 'top top',
        end: () => '+=' + window.innerHeight, // Motion v3: ~100vh (was 150)
        pin: true,
        anticipatePin: 1,
        scrub: 0.3,
        invalidateOnRefresh: true,
      });
    } else {
      // Phones/tablets: no pin, no slides; light up as the paragraph passes through.
      lightUp({ trigger: text, start: 'top 85%', end: 'bottom 40%', scrub: 0.3 });
    }
    return () => {
      split.revert();
      if (dot) gsap.set(dot, { clearProps: 'transform' });
    };
  });
</script>
