---
/**
 * Home §4 — Four pillars as numbered editorial rows: (01)–(04), a hairline that
 * draws left → right above each row, and an arrow that nudges 4px on hover.
 * Each whole row is one link (to the service it maps to), so it works the same
 * by tap, click or keyboard — nothing is hover-only. CSS only, no JavaScript.
 */
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';

const pillars = (await getCollection('pillars')).sort((a, b) => a.data.order - b.data.order);
---

<section id="pillars" class="pillars" aria-labelledby="pillars-title">
  <div class="container-content">
    <SectionHeader eyebrow={home.pillars.eyebrow} id="pillars-title" title={home.pillars.title} intro={home.pillars.intro} />

    <ol class="pillars__list" role="list">
      {
        pillars.map((p, i) => (
          <li class="pillar">
            <span class="pillar__rule" data-draw-x style={`--i:${i}`} aria-hidden="true" />
            <a href={p.data.href} class="pillar__link" data-reveal style={`--i:${i}`}>
              <span class="pillar__num" aria-hidden="true">
                ({String(i + 1).padStart(2, '0')})
              </span>
              <h3 class="pillar__title">
                {/* Keep hyphenated words (Customer-Centric) on one line. */}
                {p.data.title.split(' ').map((w, wi) => (
                  <>
                    {wi > 0 && ' '}
                    {w.includes('-') ? <span class="nowrap">{w}</span> : w}
                  </>
                ))}
              </h3>
              <span class="pillar__body">
                <span class="pillar__line">{p.data.line}</span>
                <span class="pillar__service">
                  <span class="sr-only">Service: </span>
                  {p.data.service}
                </span>
              </span>
              <Icon name="arrow-right" size={24} class="pillar__arrow" />
            </a>
          </li>
        ))
      }
      <li class="pillar pillar--end" aria-hidden="true">
        <span class="pillar__rule" data-draw-x style={`--i:${pillars.length}`} />
      </li>
    </ol>
  </div>
</section>

<style>
  .pillars {
    padding-block: var(--section-space);
  }
  .pillars__list {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .pillar {
    position: relative;
  }
  .pillar__rule {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--color-hairline);
  }
  .pillar--end {
    height: 1px;
  }

  /* ---------- Row: phones (stacked) ---------- */
  .pillar__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'num   title arrow'
      'body  body  body';
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.75rem;
    padding-block: 1.75rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .pillar__num {
    grid-area: num;
    font-size: var(--text-small);
    color: var(--color-stone);
    font-variant-numeric: tabular-nums;
  }
  .pillar__title {
    grid-area: title;
    font-size: var(--text-h3);
    line-height: 1.15;
    transition: color var(--dur-tap) var(--ease);
  }
  .pillar__title .nowrap {
    white-space: nowrap;
  }
  .pillar__body {
    grid-area: body;
    display: grid;
    gap: 0.4rem;
  }
  .pillar__line {
    max-width: 46ch;
  }
  .pillar__service {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-green);
  }
  .pillar__link :global(.pillar__arrow) {
    grid-area: arrow;
    align-self: center;
    color: var(--color-brass);
    transition: transform var(--dur-tap) var(--ease);
  }

  /* ---------- Row: tablet & desktop (one line per pillar) ---------- */
  @media (min-width: 768px) {
    .pillar__link {
      grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.15fr) 2.5rem;
      grid-template-areas: 'num title body arrow';
      column-gap: 1.5rem;
      padding-block: 2.25rem;
    }
    .pillar__link :global(.pillar__arrow) {
      justify-self: end;
    }
    .pillar__line {
      max-width: none;
    }
  }

  /* Hover & focus: title turns green, arrow nudges 4px (150–200ms). */
  .pillar__link:hover .pillar__title,
  .pillar__link:focus-visible .pillar__title {
    color: var(--color-green);
  }
  .pillar__link:focus-visible :global(.pillar__arrow) {
    transform: translateX(4px);
  }
  @media (hover: hover) {
    .pillar__link:hover :global(.pillar__arrow) {
      transform: translateX(4px);
    }
  }
  .pillar__link:focus-visible {
    outline-offset: 6px;
  }
</style>
