---
/**
 * Home §5 — Four pillars, as Onda's stacked service cards (Motion v4).
 * - Each pillar is a large green card. From 768px the cards are sticky, each
 *   one 14px lower than the last, so they pile up as you scroll. While the
 *   next card slides over, the one underneath shrinks to 0.9 and darkens
 *   (GSAP scrub; only transform and opacity animate).
 * - Phones: a plain list of cards (Motion v3: no pins on phones).
 * - Reduced motion: no sticky, no scaling. JS off: sticky cards, no scaling.
 * Onda's cards have photos; these carry a giant outlined numeral instead.
 */
import { getCollection } from 'astro:content';
import home from '../../data/home.json';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';

const pillars = (await getCollection('pillars'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p, i) => ({ ...p.data, num: String(i + 1).padStart(2, '0') }));
---

<section id="pillars" class="pillars" aria-labelledby="pillars-title">
  <div class="container-content">
    <SectionHeader eyebrow={home.pillars.eyebrow} id="pillars-title" title={home.pillars.title} intro={home.pillars.intro} />

    <ol class="svc-deck" role="list" data-svc-deck>
      {
        pillars.map((p, i) => (
          <li class="svc" style={`--i:${i}`} data-svc>
            <div class="svc__text">
              <p class="svc__num" aria-hidden="true">{p.num}</p>
              <h3 class="svc__title">{p.title}</h3>
              <p class="svc__line">{p.line}</p>
              <p class="svc__tags">
                <span class="sr-only">Service: </span>
                <span class="svc__tag">{p.service}</span>
              </p>
              <a href={p.href} class="svc__more">
                Learn more <Icon name="arrow-right" size={18} />
              </a>
            </div>
            <div class="svc__media" aria-hidden="true">
              <span class="svc__big">{p.num}</span>
              <span class="svc__tri"></span>
            </div>
            <span class="svc__shade" data-svc-shade aria-hidden="true"></span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .pillars {
    padding-block: var(--section-space);
  }
  .svc-deck {
    display: grid;
    gap: 1.25rem;
    margin: clamp(2.5rem, 7vh, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .svc {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 2.4vw, 2.25rem);
    overflow: hidden;
    border-radius: 20px;
    background-color: var(--color-green);
    color: var(--color-ivory);
    box-shadow: 0 -10px 30px -18px rgb(28 31 30 / 0.45);
    transform-origin: 50% 0;
  }
  /* Grain on the card, like the green bands. */
  .svc::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    opacity: 0.55;
    pointer-events: none;
  }
  .svc__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .svc__num {
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-brass-light);
    font-variant-numeric: tabular-nums;
  }
  .svc__title {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    line-height: 1.02;
    font-weight: 600;
    text-wrap: balance;
  }
  .svc__line {
    max-width: 28rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: rgb(246 241 231 / 0.82);
  }
  .svc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .svc__tag {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--color-hairline-on-green);
    border-radius: 999px;
    font-size: var(--text-small);
    color: var(--color-brass-light);
  }
  .svc__more {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--color-ivory);
    text-decoration: none;
  }
  .svc__more :global(svg) {
    transition: transform var(--dur-tap) var(--ease-ui);
  }
  .svc__more:hover :global(svg),
  .svc__more:focus-visible :global(svg) {
    transform: translateX(6px);
  }
  .svc__more:focus-visible {
    outline-color: var(--color-brass-light);
  }

  /* The "photo" panel: a giant outlined numeral with a brass prism corner. */
  .svc__media {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 16 / 9;
    background: var(--color-green-deep);
    border: 1px solid var(--color-hairline-on-green);
  }
  .svc__big {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(7rem, 4rem + 14vw, 20rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-brass);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .svc__tri {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 1.1rem;
    height: 1.1rem;
    background: var(--color-brass);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  /* Darkens the card underneath while the next one slides over it. */
  .svc__shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--color-ink);
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .svc {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(1.5rem, 3vw, 3rem);
      height: min(62svh, 560px);
      min-height: 400px;
    }
    .svc__media {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  /* Onda's pile: sticky from 768px, each card 14px lower than the last. */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .svc {
      position: sticky;
      top: calc(clamp(80px, 12svh, 108px) + var(--i) * 14px);
    }
  }
</style>

<script>
  import { gsap, registerScene, isPhone } from '../../lib/tools';

  registerScene('pillars', ({ reduce }) => {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-svc]')];
    if (reduce || isPhone() || cards.length < 2) return;

    // Sticky cards can't be measured where they sit, so work from their
    // natural (un-stuck) positions: the deck's top plus the cards above.
    const deck = document.querySelector<HTMLElement>('[data-svc-deck]')!;
    const naturalTop = (k: number) => {
      const gap = parseFloat(getComputedStyle(deck).rowGap) || 0;
      let y = deck.getBoundingClientRect().top + window.scrollY;
      for (let j = 0; j < k; j++) y += cards[j].offsetHeight + gap;
      return y;
    };
    const stickyTop = (el: HTMLElement) => parseFloat(getComputedStyle(el).top) || 0;

    // As card i+1 rises to its sticky slot, card i shrinks to 0.9 and darkens.
    const tweens = cards.slice(0, -1).map((card, i) => {
      const next = cards[i + 1];
      const shade = card.querySelector<HTMLElement>('[data-svc-shade]')!;
      return gsap
        .timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            start: () => naturalTop(i + 1) - window.innerHeight,
            end: () => naturalTop(i + 1) - stickyTop(next),
            scrub: true,
            invalidateOnRefresh: true,
          },
        })
        .to(card, { scale: 0.9 }, 0)
        .to(shade, { opacity: 0.55 }, 0);
    });
    return () => {
      tweens.forEach((t) => t.kill());
      gsap.set(cards, { clearProps: 'transform' });
    };
  });
</script>
