---
/**
 * Green footer. Links and details first; the footer then ends with
 * "Saifuddin Kapasi" set edge to edge in huge Cormorant, rising into place as
 * you reach the bottom, then the sign-off "Ideas are easy. Impact is earned." On desktop the travelling prism reappears,
 * small, beside the sign-off. "Back to top" scrolls with Lenis.
 * Small text on green uses light brass (6.0:1); body text is ivory (10.5:1).
 */
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import Icon from './Icon.astro';
import InflectionEdge from './InflectionEdge.astro';
import InflectionLine from './InflectionLine.astro';
import RevealWords from './RevealWords.astro';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
const { contact, nav } = site;
const year = new Date().getFullYear();

// "Ideas are easy. Impact is earned." → the second sentence in italic light brass.
const [first, second] = site.signOff.split(/(?<=\.)\s+/);
const signOffText = `${first} ${second
  .split(' ')
  .map((w) => `*${w}*`)
  .join(' ')}`;
---

<!-- Way in: the green footer rises along the inflection curve. -->
<InflectionEdge class="footer-edge" />
<footer class="on-green site-footer" data-site-footer>
  <!-- Prism waypoint: it travels hidden down to here, then fades in by the sign-off. -->
  <span class="footer-prism-in" data-prism-stop="footer-in" data-prism-opacity="0" data-prism-scale="0.3" data-prism-beam="0" data-prism-anchor="right" data-prism-dx="-260" aria-hidden="true"></span>
  <div class="container-content">
    <div class="footer-grid">
      <div class="footer-about">
        <a href="/" class="footer-wordmark">{site.shortName}</a>
        <p class="mt-3 text-ivory">{site.tagline}</p>
        <p class="mt-4 text-small text-brass-light">
          Director, Inflection Point<br />
          <span class="italic">{site.inflectionPointLine}</span>
        </p>
      </div>

      <nav aria-labelledby="footer-explore">
        <p id="footer-explore" class="eyebrow">Explore</p>
        <ul class="footer-list" role="list">
          {nav.menu.map((l) => <li><a href={l.href} class="footer-link link-grow-line">{l.label}</a></li>)}
          {/* Folded into About in Motion v3; still one click from every page. */}
          <li><a href="/about/#recognition" class="footer-link link-grow-line">Achievements</a></li>
          <li><a href="/about/#students" class="footer-link link-grow-line">Students</a></li>
        </ul>
      </nav>

      <div>
        <p class="eyebrow" id="footer-books">Books</p>
        <ul class="footer-list" role="list" aria-labelledby="footer-books">
          {
            books.map((b) => (
              <li>
                <a href={`/books/#${b.id}`} class="footer-link link-grow-line">
                  {b.data.title} {b.data.titleAccent}
                </a>
              </li>
            ))
          }
          <li><a href="/contact?enquiry=books" class="footer-link link-grow-line">Bulk orders &amp; signed copies</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow" id="footer-contact">Get in touch</p>
        <ul class="footer-list" role="list" aria-labelledby="footer-contact">
          <li>
            <a href={`mailto:${contact.email}`} class="footer-link footer-link--icon">
              <Icon name="mail" /><span class="link-grow-line">Email</span>
            </a>
          </li>
          <li>
            <a href={`https://wa.me/${contact.whatsapp}`} class="footer-link footer-link--icon" rel="noopener" target="_blank">
              <Icon name="whatsapp" /><span class="link-grow-line">WhatsApp</span>
            </a>
          </li>
          <li>
            <a href={contact.linkedin} class="footer-link footer-link--icon" rel="noopener" target="_blank">
              <Icon name="linkedin" /><span class="link-grow-line">LinkedIn</span>
            </a>
          </li>
          <li class="pt-2 text-small text-brass-light">{contact.location}</li>
          {contact.placeholder && (
            <li>
              <span class="placeholder-tag">Placeholder contact details</span>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>© {year} {site.name}. All rights reserved.</p>
      <a href="#main" class="footer-top" data-to-top>
        Back to top <Icon name="arrow-up" size={18} />
      </a>
    </div>
  </div>

  <div class="footer-end">
    <p class="footer-name" data-footer-name>{site.shortName}</p>
    <div class="container-content footer-sign">
      <div class="footer-sign__line">
        <InflectionLine variant="divider" />
      </div>
      <div class="footer-sign__row">
        <RevealWords as="p" text={signOffText} accentClass="signoff-accent" class="signoff" />
        <span
          class="footer-prism"
          data-prism-stop="footer"
          data-prism-scale="0.34"
          data-prism-beam="0.35"
          data-prism-spectrum="0.8"
          data-prism-vy="0.72"
          aria-hidden="true"
        ></span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-green);
    color: var(--color-ivory);
    padding-top: var(--section-space);
    padding-bottom: max(2rem, calc(env(safe-area-inset-bottom) + 1.5rem));
  }
  .site-footer :global(.inflection-line) {
    color: var(--color-brass);
  }

  .footer-prism-in {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
  }

  /* ---------- The ending: giant name + sign-off ---------- */
  .footer-end {
    position: relative;
    z-index: 2;
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .footer-name {
    margin: 0;
    padding-inline: clamp(0.5rem, 1.2vw, 1.25rem);
    font-family: var(--font-serif);
    font-weight: 700;
    /* "Saifuddin Kapasi" fills the width, edge to edge. */
    font-size: 14.4vw; /* design v5: Gabarito is wider than the old serif */
    line-height: 0.86;
    letter-spacing: -0.04em;
    white-space: nowrap;
    text-align: center;
    color: var(--color-ivory);
  }
  .footer-sign {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .footer-sign__row {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-top: 1.5rem;
  }
  .footer-prism {
    flex: 0 0 9rem;
    height: 1px;
    margin-left: auto;
  }
  @media (max-width: 1023.98px) {
    .footer-prism {
      display: none;
    }
  }

  /* :global — the element is rendered inside RevealWords, outside this scope. */
  .site-footer :global(.signoff) {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    letter-spacing: -0.01em;
    color: var(--color-ivory);
    text-wrap: balance;
  }
  .site-footer :global(.signoff-accent) {
    font-style: italic;
    color: var(--color-brass-light);
  }

  .footer-grid {
    display: grid;
    gap: 2.75rem 2rem;
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-about {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
    .footer-about {
      grid-column: auto;
    }
  }

  .footer-wordmark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--color-ivory);
    text-decoration: none;
  }

  .footer-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-ivory);
    text-decoration: none;
    transition: color var(--dur-tap) var(--ease);
  }
  .footer-link:hover {
    color: var(--color-brass-light);
  }
  .footer-link--icon {
    gap: 0.75rem;
  }
  .footer-link--icon :global(svg) {
    color: var(--color-brass-light);
  }

  .btn-on-green {
    background: var(--color-ivory);
    color: var(--color-green);
  }
  .btn-on-green:hover {
    background: #fff;
  }

  .site-footer .placeholder-tag {
    color: var(--color-brass-light);
    border-color: var(--color-brass-light);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline-on-green);
    font-size: var(--text-small);
    color: var(--color-brass-light);
  }
  .footer-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: var(--color-brass-light);
    font-weight: 600;
    text-decoration: none;
  }
  .footer-top :global(svg) {
    transition: transform var(--dur-tap) var(--ease);
  }
  @media (hover: hover) {
    .footer-top:hover :global(svg) {
      transform: translateY(-4px);
    }
  }
</style>

<script>
  import { gsap, registerScene, revealTrigger, isPhone } from '../lib/tools';
  import { onPageLoad } from '../lib/page';

  // The giant name rises into place once as the page reaches its end
  // (Motion v3: a fade-up — characters split only on the hero name).
  registerScene('footer-name', ({ reduce }) => {
    const name = document.querySelector<HTMLElement>('[data-footer-name]');
    if (!name || reduce) return;
    gsap.from(name, { autoAlpha: 0, y: isPhone() ? 12 : 24, duration: isPhone() ? 0.5 : 0.9, ease: 'expo.out', scrollTrigger: revealTrigger(name) });
  });

  // "Back to top": smooth with Lenis on desktop, native jump elsewhere; focus moves to main.
  onPageLoad(() => {
    document.querySelector('[data-to-top]')?.addEventListener('click', (e) => {
      e.preventDefault();
      const lenis = (window as any).__lenis;
      if (lenis) lenis.scrollTo(0);
      else window.scrollTo({ top: 0 });
      const main = document.getElementById('main');
      if (main) {
        main.setAttribute('tabindex', '-1');
        main.focus({ preventScroll: true });
      }
    });
  });
</script>
