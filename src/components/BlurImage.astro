---
/**
 * Responsive image (AVIF/WebP, srcset + sizes) over a tiny blurred placeholder.
 * With `fade` (default), the photo sharpens in from blur 8px → 0 as it loads.
 * Above-the-fold images use `priority` (eager, high fetch priority) and no fade,
 * so they never wait on JavaScript.
 * `clip` (Motion v2): a clip-path wipe reveal with the image scaling 1.15 → 1
 * (engine primitive [data-clip]; visible with JS off and reduced motion).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { blurDataURL } from '../lib/blur';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  fade?: boolean;
  class?: string;
  /** CSS object-position for the crop. */
  position?: string;
  /** Clip-path wipe reveal direction (Motion v2). */
  clip?: 'up' | 'down' | 'left' | 'right';
}

const {
  src,
  alt,
  sizes,
  widths = [400, 640, 800, 1000, 1280, 1600].filter((w) => w <= src.width),
  priority = false,
  fade = !priority,
  class: className,
  position = 'center',
  clip,
} = Astro.props;

const placeholder = await blurDataURL(src);
---

<div
  class:list={['blur-img', className]}
  style={placeholder ? `--ph:url(${placeholder})` : undefined}
  {...fade ? { 'data-blur-img': '' } : {}}
  {...clip ? { 'data-clip': clip } : {}}
>
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    priority={priority}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    pictureAttributes={{ class: 'blur-img__picture' }}
    class="blur-img__img"
    style={`object-position:${position}`}
  />
</div>

<style>
  .blur-img {
    position: relative;
    overflow: hidden;
    background-color: var(--color-ivory-deep);
    isolation: isolate;
  }
  /* Tiny placeholder, blurred and slightly scaled so its edges stay soft. */
  .blur-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--ph);
    background-size: cover;
    background-position: center;
    filter: blur(16px);
    transform: scale(1.1);
  }
  .blur-img :global(.blur-img__picture),
  .blur-img :global(.blur-img__img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .blur-img :global(.blur-img__img) {
    object-fit: cover;
  }
  :global(html.js) .blur-img[data-blur-img] :global(.blur-img__img) {
    opacity: 0;
    filter: blur(var(--blur-max));
    transition:
      opacity var(--dur-reveal) var(--ease),
      filter var(--dur-reveal) var(--ease);
  }
  :global(html.js) .blur-img[data-blur-img].is-loaded :global(.blur-img__img) {
    opacity: 1;
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .blur-img[data-blur-img] :global(.blur-img__img) {
      opacity: 1 !important;
      filter: none !important;
    }
  }
</style>

<script>

  import { onPageLoad } from '../lib/page';
  function setup() {
    document.querySelectorAll<HTMLElement>('[data-blur-img]:not(.is-loaded)').forEach((wrap) => {
      const img = wrap.querySelector('img');
      if (!img) return;
      const done = () => wrap.classList.add('is-loaded');
      if (img.complete && img.naturalWidth > 0) done();
      else {
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
      }
    });
  }
  onPageLoad(setup);
</script>
<noscript>
  <style>
    .blur-img__img {
      opacity: 1 !important;
      filter: none !important;
    }
  </style>
</noscript>
