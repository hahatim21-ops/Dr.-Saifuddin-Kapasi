---
/**
 * Heading reveal. Renders the text as plain HTML (fully visible with JS off).
 * Motion v3 tiers: only h1 and section h2s get the SplitText line reveal
 * (lines rise out of masks); anything else (h3, display lines, sign-offs) gets
 * the plain Tier 2 fade-up instead.
 * `now` plays on load instead of on scroll-in. SplitText's aria option keeps the
 * sentence whole for screen readers. Wrap one word in *asterisks* for the
 * italic green accent.
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'div' | 'span';
  class?: string;
  /** Delay before the reveal, in ms. */
  delay?: number;
  /** Kept for API compatibility (v1 word gap); unused. */
  stagger?: number;
  /** Play on load instead of on scroll-in. */
  now?: boolean;
  /** Class applied to the accent word (defaults to italic green). */
  accentClass?: string;
  id?: string;
}

const { text, as: Tag = 'p', class: className, delay = 0, now = false, accentClass = 'accent', id } = Astro.props;
const isSplit = Tag === 'h1' || Tag === 'h2';
const motion = isSplit
  ? {
      'data-split': 'lines',
      ...(now ? { 'data-split-now': '' } : {}),
      ...(delay ? { 'data-split-delay': String(delay / 1000) } : {}),
    }
  : { 'data-reveal': '', ...(now ? { 'data-reveal-now': '' } : {}), ...(delay ? { style: `--delay:${delay}ms` } : {}) };

const parts = text
  .split(/(\*[^*]+\*)/)
  .filter(Boolean)
  .map((p) => (p.startsWith('*') && p.endsWith('*') ? { text: p.slice(1, -1), accent: true } : { text: p, accent: false }));
---

<Tag
  class:list={['reveal-split', className]}
  id={id}
  {...motion}
>{parts.map((p) => (p.accent ? <em class={accentClass}>{p.text}</em> : p.text))}</Tag>
