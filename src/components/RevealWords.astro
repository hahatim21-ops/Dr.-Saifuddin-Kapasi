---
/**
 * Motion v2 heading reveal. Renders the text as plain HTML (fully visible with
 * JS off) and marks it for the engine's SplitText primitive:
 *   - headings (h1/h2/h3): lines rise out of masks (yPercent 110 → 0, 0.08s apart)
 *   - other tags: words rise out of masks
 * `now` plays on load instead of on scroll-in. SplitText's aria option keeps the
 * sentence whole for screen readers. Wrap one word in *asterisks* for the
 * italic green accent.
 */
interface Props {
  text: string;
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'div' | 'span';
  class?: string;
  /** Delay before the reveal, in ms. */
  delay?: number;
  /** Kept for API compatibility (v1 word gap); unused. */
  stagger?: number;
  /** Play on load instead of on scroll-in. */
  now?: boolean;
  /** Class applied to the accent word (defaults to italic green). */
  accentClass?: string;
  id?: string;
  /** Override the split kind. */
  split?: 'lines' | 'words' | 'chars';
}

const { text, as: Tag = 'p', class: className, delay = 0, now = false, accentClass = 'accent', id, split } = Astro.props;
const kind = split ?? (Tag === 'h1' || Tag === 'h2' || Tag === 'h3' ? 'lines' : 'words');

const parts = text
  .split(/(\*[^*]+\*)/)
  .filter(Boolean)
  .map((p) => (p.startsWith('*') && p.endsWith('*') ? { text: p.slice(1, -1), accent: true } : { text: p, accent: false }));
---

<Tag
  class:list={['reveal-split', className]}
  id={id}
  data-split={kind}
  {...now ? { 'data-split-now': '' } : {}}
  {...delay ? { 'data-split-delay': String(delay / 1000) } : {}}
>{parts.map((p) => (p.accent ? <em class={accentClass}>{p.text}</em> : p.text))}</Tag>
