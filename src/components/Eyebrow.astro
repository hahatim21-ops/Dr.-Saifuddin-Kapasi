---
/** Small uppercase label in stone, preceded by the 24px brass inflection glyph. */
import InflectionLine from './InflectionLine.astro';

interface Props {
  as?: 'p' | 'span' | 'div' | 'h2' | 'h3';
  class?: string;
}
const { as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['eyebrow', className]}>
  <InflectionLine variant="glyph" />
  <span><slot /></span>
</Tag>
